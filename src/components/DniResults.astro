---
// src/components/DniResults.astro
// Sección de resultados DNI (10 tarjetas oficiales con acordiones, insignias y verificación de fuente)
---

<div id="dni-results-section" class="w-full max-w-[1100px] mt-8 px-4 sm:px-6 md:px-8 z-10 hidden">
    <div class="flex items-center justify-between border-b border-amber-200/60 pb-2.5 mb-6 gap-2">
        <div class="flex items-center gap-3 text-slate-800">
            <i class="far fa-id-card text-[#a36b1d] text-lg sm:text-xl"></i>
            <h2 class="text-base sm:text-xl font-bold tracking-wide font-poppins text-slate-900">Resultados del Análisis</h2>
        </div>
        <div class="flex items-center gap-2 shrink-0 select-none bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-xl border border-amber-200/60 shadow-2xs">
            <div class="w-6 h-6 rounded-md overflow-hidden flex items-center justify-center">
                <img src="/assets/logocañitaoficial2026.png" class="w-full h-full object-contain rounded" alt="Logo Cañita" />
            </div>
            <span class="text-slate-850 font-archivo text-[11px] md:text-xs font-black tracking-tight">CAÑITA</span>
        </div>
    </div>

    {/* Estado Inicial: Esperando Documento */}
    <div id="dni-initial-state" class="w-full max-w-3xl md:max-w-4xl mx-auto text-center py-12 px-6 sm:px-12 md:px-16 rounded-3xl border border-dashed border-amber-200/80 bg-white/90 shadow-[0_10px_30px_-5px_rgba(200,160,80,0.08)] text-slate-900 font-poppins">
        <div class="w-16 h-16 mx-auto mb-3 flex items-center justify-center text-3xl text-amber-500/90">
            <i class="fas fa-folder-open text-4xl text-[#d4af37]"></i>
        </div>
        <p class="font-extrabold text-slate-800 text-lg">Esperando Documento de Identidad</p>
        <p class="text-xs text-slate-500 mt-1 max-w-[300px] mx-auto leading-relaxed">
            Ingresa un número de DNI de 8 dígitos arriba para consultar antecedentes y datos públicos oficiales en tiempo real.
        </p>
    </div>

    {/* Contenedor de Tarjetas de Secciones DNI (10 tarjetas oficiales) */}
    <div id="dni-cards-container" class="hidden flex-col gap-3.5 sm:gap-4 mt-4 mb-16">
        
        {/* 1. INFORMACIÓN PERSONAL */}
        <div id="dni-card-identidad" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-identidad')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/perushield.png" alt="IDENTIDAD" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">INFORMACIÓN PERSONAL</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">IDENTIDAD OFICIAL</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <span class="inline-block w-2.5 h-2.5 rounded-full border-2 border-white border-t-transparent spin-icon"></span> Consultando
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Consultando datos oficiales de identidad...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 2. LICENCIA DE CONDUCIR (MTC) */}
        <div id="dni-card-transporte_licencias" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-transporte_licencias')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/mtc.png" alt="MTC" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">LICENCIA DE CONDUCIR MTC</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">MTC SISTEMA NACIONAL DE CONDUCTORES</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Verificando brevete oficial y vigencia MTC...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 3. SUNAT RUC */}
        <div id="dni-card-sunat" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-sunat')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/perushield.png" alt="SUNAT" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">CONSULTA ESTADO RUC (SUNAT)</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">SUNAT REGISTRO TRIBUTARIO</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Verificando padrón tributario RUC...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 4. JNE MULTAS ELECTORALES */}
        <div id="dni-card-jne_multas" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-jne_multas')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/perushield.png" alt="JNE" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">MULTAS ELECTORALES JNE</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">JURADO NACIONAL DE ELECCIONES</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Consultando multas de votación y miembros de mesa...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 5. RÉCORD DEL CONDUCTOR */}
        <div id="dni-card-transporte_record" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-transporte_record')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/mtc.png" alt="MTC" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">MTC - RÉCORD DEL CONDUCTOR</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">MTC PUNTOS Y SANCIONES</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Verificando puntos acumulados y sanciones firmes...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 6. MTC - PAPELETAS Y SANCIONES */}
        <div id="dni-card-transporte_papeletas" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-transporte_papeletas')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/mtc.png" alt="MTC" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">MTC – CONSULTA DE PAPELETAS / SANCIONES</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">MTC SISTEMA DE FISCALIZACIÓN Y SANCIONES</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Verificando infracciones y sanciones MTC asociadas al DNI...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 7. GRADOS Y TÍTULOS SUPERIORES (MINEDU) */}
        <div id="dni-card-minedu" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-minedu')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/perushield.png" alt="MINEDU" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">GRADOS Y TÍTULOS SUPERIORES</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">MINEDU REGISTRO DE GRADOS</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>
                </div>
            </div>
            <div class="accordion-body hidden border-t border-slate-100 bg-white p-4 sm:p-5 font-poppins">
                <div class="card-skeleton flex flex-col items-center justify-center py-6 gap-3 text-center font-poppins">
                    <span class="inline-block w-8 h-8 rounded-full border-2 border-slate-300 border-t-amber-600 animate-spin"></span>
                    <p class="text-xs font-bold text-slate-700">Consultando registro de grados y títulos superiores...</p>
                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 8. OECE - PROVEEDORES ADJUDICADOS Y CONTRATACIONES PÚBLICAS */}
        <div id="dni-card-osce" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-osce')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/perushield.png" alt="OSCE" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">OECE - Proveedores Adjudicados y CONTRATACIONES PUBLICAS</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">SEACE / OSCE ANTECEDENTES Y CONTRATACIONES PÚBLICAS</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900 text-white border border-slate-900 shadow-sm uppercase tracking-wider font-poppins">
                            <i class="fas fa-clock text-slate-300 animate-pulse text-[10px]"></i> En espera
                        </span>
                    </div>
                    <i class="fas fa-chevron-down accordion-chevron transition-transform duration-300 text-xs sm:text-sm text-slate-400"></i>

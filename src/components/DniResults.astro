                </div>
                <div class="card-body-content hidden"></div>
            </div>
        </div>

        {/* 9. HISTORIAL POLÍTICO (INFOGOB) */}
        <div id="dni-card-infogob" class="accordion-card results-card bg-white border-2 border-slate-900 rounded-2xl shadow-md flex flex-col overflow-hidden font-poppins transition-all duration-300">
            <div onclick="window.toggleDniAccordion('dni-card-infogob')" class="accordion-header flex items-center justify-between gap-3 sm:gap-4 p-3.5 sm:p-4 cursor-pointer select-none transition-all duration-300 hover:bg-slate-50/60 bg-white">
                <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs overflow-hidden p-1 sm:p-1.5">
                        <img src="/assets/perushield.png" alt="INFOGOB" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="min-w-0 text-left font-poppins">
                        <h3 class="text-xs sm:text-sm font-black tracking-wide uppercase leading-tight text-slate-900">HISTORIAL POLÍTICO (INFOGOB)</h3>
                        <p class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase mt-0.5 text-slate-400">JNE INFOGOB REGISTRO POLÍTICO</p>
                    </div>
                </div>
                <div class="flex min-w-0 shrink-0 items-center justify-end gap-2 sm:gap-3">
                    <div class="status-badge-container">

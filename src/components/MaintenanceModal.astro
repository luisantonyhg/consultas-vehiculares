---
// Modal global de mantenimiento temporalmente activado.
// Para desactivarlo, restaurar: import.meta.env.PUBLIC_MAINTENANCE_MODE === 'true'
const isMaintenance = import.meta.env.PUBLIC_MAINTENANCE_MODE !== 'false';
---

<div id="mnt-modal"
     class="fixed inset-0 z-[100] hidden items-center justify-center p-5"
     role="dialog" aria-modal="true" aria-labelledby="mnt-title" aria-describedby="mnt-desc">
    <div class="absolute inset-0 bg-white/80 backdrop-blur-md" id="mnt-backdrop"></div>

    <div class="mnt-card relative w-full max-w-[400px] rounded-2xl bg-white border border-slate-200 shadow-[0_24px_60px_-24px_rgba(11,28,54,0.25)] px-8 pt-9 pb-8 text-center font-inter">
        <img src="/assets/logocañitaoficial2026.png" alt="Cañita"
             class="mx-auto h-10 w-auto max-w-[130px] object-contain" />

        <div class="mx-auto mt-7 flex h-12 w-12 items-center justify-center rounded-full bg-slate-50 border border-slate-200">
            <i class="fas fa-screwdriver-wrench text-brand-navy-dark text-lg" aria-hidden="true"></i>
        </div>

        <h2 id="mnt-title" class="mt-5 text-[22px] leading-tight font-bold text-brand-navy-dark tracking-tight">
            Estamos mejorando el sistema
        </h2>

        <p id="mnt-desc" class="mt-3 text-md leading-relaxed text-slate-500">
            Por el momento las consultas no están disponibles.
            Volveremos a estar en línea muy pronto.
        </p>

        <div class="mt-7 border-t border-slate-100 pt-5">
            <p class="text-sm text-slate-400">Gracias por tu paciencia.</p>
        </div>
    </div>
</div>

<style>
    .mnt-card { animation: mntIn 0.35s ease-out both; }
    @keyframes mntIn {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
        .mnt-card { animation: none; }
    }
</style>

<script define:vars={{ isMaintenance }}>
    function openModal() {
        const el = document.getElementById('mnt-modal');
        if (!el) return;
        el.classList.remove('hidden');
        el.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        // Durante el mantenimiento el modal no se puede cerrar: no hay nada que consultar.
        if (window.__maintenanceMode) return;
        const el = document.getElementById('mnt-modal');
        if (!el) return;
        el.classList.add('hidden');
        el.classList.remove('flex');
        document.body.style.overflow = '';
    }

    window.showMaintenanceModal = openModal;
    window.closeMaintenanceModal = closeModal;
    window.__maintenanceMode = Boolean(isMaintenance);

    function applyMaintenanceUI() {
        openModal();
        document.querySelectorAll('#submit-btn, #query-form button[type="submit"]').forEach((btn) => {
            btn.disabled = true;
            btn.classList.add('opacity-60', 'cursor-not-allowed');
            btn.innerHTML = '<i class="fas fa-wrench"></i> Mantenimiento';
        });
        document.querySelectorAll('#query-form input, #query-form select').forEach((field) => {
            field.disabled = true;
        });
        const qs = document.getElementById('query-status');
        if (qs) {
            qs.innerHTML = '<span class="text-slate-500 font-semibold"><i class="fas fa-wrench mr-1"></i>Sistema en mantenimiento. Las consultas no están disponibles.</span>';
            qs.classList.remove('opacity-0');
        }
    }

    if (isMaintenance) {
        // Bloquea cualquier envío de formulario, incluso si se dispara por teclado.
        document.addEventListener('submit', (event) => {
            event.preventDefault();
            event.stopImmediatePropagation();
            openModal();
        }, true);
        document.addEventListener('DOMContentLoaded', applyMaintenanceUI);
    }
</script>

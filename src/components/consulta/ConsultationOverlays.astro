<!-- Loader claro Cañita -->
<div id="loading-overlay" class="fixed inset-0 z-[120] hidden opacity-0 transition-all duration-300 items-center justify-center p-5 backdrop-blur-sm"
     style="background: radial-gradient(circle at 50% 40%, rgba(255,255,255,.98) 0%, rgba(248,250,252,.97) 55%, rgba(226,232,240,.96) 100%);">
    <div class="relative flex w-full max-w-[390px] flex-col items-center rounded-[28px] border border-slate-200 bg-white/95 px-5 py-8 text-center shadow-[0_24px_70px_rgba(15,23,42,.13)] ring-1 ring-black/[.025] sm:px-8">
        <img src="/assets/logocañitaoficial2026.png" alt="Cañita" class="mb-5 h-9 w-auto max-w-[125px] rounded-lg object-contain" />

        <div class="loader-license-plate relative w-full max-w-[330px] overflow-hidden rounded-xl">
            <img src="/assets/PERU-PLACA-REGULAR.png" alt="Placa vehicular peruana" class="block h-auto w-full" />
            <div class="absolute left-[4.5%] right-[4.5%] top-[27%] bottom-[11%] flex items-center justify-center bg-white">
                <span id="loader-plate-badge" class="font-archivo whitespace-nowrap text-[clamp(2.4rem,13vw,4.15rem)] font-black leading-none tracking-[-.08em] text-black">---</span>
            </div>
            <div class="absolute right-[4.5%] top-[9%] flex h-[16%] min-w-[18%] items-center justify-center rounded-md bg-slate-200 px-1">
                <span id="loader-plate-mini" class="text-[clamp(.55rem,2.5vw,.9rem)] font-black tracking-tight text-slate-500">---</span>
            </div>
        </div>

        <h3 class="mt-6 text-base font-black uppercase tracking-[.08em] text-slate-950 sm:text-lg">Consultando vehículo</h3>
        <p id="loader-status-text" class="mt-1.5 min-h-[20px] text-[11px] font-semibold leading-relaxed text-slate-500 sm:text-xs">Preparando consulta segura...</p>

    </div>
</div>

<!-- Admisión protegida: se muestra antes de iniciar consultas costosas. -->
<div id="consultation-queue-modal" class="fixed inset-0 z-[130] hidden items-center justify-center bg-slate-950/65 p-4 backdrop-blur-sm sm:p-6" role="dialog" aria-modal="true" aria-labelledby="consultation-queue-title" aria-describedby="consultation-queue-description" aria-live="polite">
    <section class="w-full max-w-md overflow-hidden rounded-[28px] border border-white/20 bg-white shadow-[0_28px_90px_rgba(15,23,42,.42)] font-poppins">
        <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-[#123b58] px-6 pb-7 pt-6 text-white sm:px-7">
            <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-emerald-300/30 bg-emerald-400/15 text-emerald-300 shadow-inner">
                    <i class="fas fa-users-viewfinder text-lg"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] font-black uppercase tracking-[.16em] text-emerald-300">Cañita protege tu turno</p>
                    <h2 id="consultation-queue-title" class="mt-1 text-xl font-black leading-tight sm:text-2xl">Estamos atendiendo varias consultas</h2>
                </div>
            </div>
        </div>
        <div class="px-6 py-6 text-slate-700 sm:px-7">
            <p id="consultation-queue-description" class="text-sm font-medium leading-relaxed text-slate-600">
                Tu turno está reservado. Espera un momento: iniciaremos automáticamente sin recargar la página.
            </p>
            <div class="mt-5 grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-amber-100 bg-amber-50 px-4 py-3">
                    <p class="text-[9px] font-black uppercase tracking-[.13em] text-amber-700">Tu posición</p>
                    <p id="consultation-queue-position" class="mt-1 text-2xl font-black tabular-nums text-slate-950">—</p>
                </div>
                <div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3">
                    <p class="text-[9px] font-black uppercase tracking-[.13em] text-emerald-700">Espera estimada</p>
                    <p id="consultation-queue-wait" class="mt-1 text-2xl font-black tabular-nums text-slate-950">—</p>
                </div>
            </div>
            <div class="mt-5 overflow-hidden rounded-full bg-slate-100 p-1" aria-hidden="true">
                <div class="h-1.5 w-2/5 animate-pulse rounded-full bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-500"></div>
            </div>
            <p class="mt-4 text-[11px] font-medium leading-relaxed text-slate-500">
                Esta espera evita que se saturen las fuentes oficiales y mantiene la consulta estable para todas las personas.
            </p>
        </div>
    </section>
</div>

<!-- Modal Oficial de Visualización de Copia de Papeleta SAT Lima -->
<div id="sat-ticket-modal" class="fixed inset-0 z-[99999] hidden items-center justify-center p-2 sm:p-4 bg-slate-950/85 backdrop-blur-md transition-all duration-300">
    <div class="relative w-full max-w-5xl bg-slate-900 rounded-2xl shadow-2xl border border-slate-800 overflow-hidden flex flex-col h-[94vh] max-h-[94vh] font-poppins">
        <!-- Header del Modal con Toolbar de Zoom -->
        <div class="flex flex-wrap items-center justify-between gap-2 px-3 sm:px-5 py-2.5 bg-slate-900/95 text-white border-b border-slate-800 z-20">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-400 shrink-0">
                    <i class="fas fa-file-invoice text-sm"></i>
                </div>
                <div class="min-w-0">
                    <h3 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-white truncate">Copia Oficial de Papeleta SAT Lima</h3>
                    <div class="flex items-center gap-2">
                        <p class="text-[10px] text-slate-400 font-mono truncate" id="sat-modal-doc-title">Documento: —</p>
                        <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-bold bg-blue-900/60 text-blue-300 border border-blue-700/50">Formato A4</span>
                    </div>
                </div>
            </div>

            <!-- Barra de Herramientas de Zoom e Interacción -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <div class="flex items-center bg-slate-800/90 border border-slate-700/80 rounded-lg p-0.5 shadow-inner">
                    <button type="button" id="sat-modal-zoom-out" class="w-7 h-7 sm:w-8 sm:h-8 rounded-md hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all cursor-pointer active:scale-95" title="Alejar (-)">
                        <i class="fas fa-magnifying-glass-minus text-xs"></i>
                    </button>
                    <span id="sat-modal-zoom-level" class="px-2 text-[11px] font-bold font-mono text-slate-200 select-none min-w-[42px] text-center" title="Nivel de zoom actual">100%</span>
                    <button type="button" id="sat-modal-zoom-in" class="w-7 h-7 sm:w-8 sm:h-8 rounded-md hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all cursor-pointer active:scale-95" title="Acercar (+)">
                        <i class="fas fa-magnifying-glass-plus text-xs"></i>
                    </button>
                    <div class="h-4 w-px bg-slate-700 mx-0.5"></div>
                    <button type="button" id="sat-modal-zoom-fit" class="px-2 h-7 sm:h-8 rounded-md hover:bg-slate-700 text-slate-300 hover:text-white flex items-center gap-1 text-[11px] font-bold transition-all cursor-pointer active:scale-95" title="Ajustar a pantalla A4">
                        <i class="fas fa-compress text-xs"></i> <span class="hidden sm:inline">Ajustar</span>
                    </button>
                </div>

                <button type="button" id="sat-modal-print-btn" class="h-8 px-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center gap-1.5 active:scale-95 cursor-pointer" title="Imprimir papeleta">
                    <i class="fas fa-print text-xs"></i> <span class="hidden md:inline">Imprimir</span>
                </button>

                <a id="sat-modal-download-btn" href="#" download="Copia_Papeleta_SAT.jpg" target="_blank" rel="noopener"
                   class="h-8 inline-flex items-center gap-1.5 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs uppercase tracking-wider transition-all shadow-xs active:scale-95 cursor-pointer" title="Descargar copia oficial">
                    <i class="fas fa-download text-xs"></i> <span class="hidden sm:inline">Descargar</span>
                </a>

                <button type="button" id="sat-modal-close-btn" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all active:scale-95 cursor-pointer" title="Cerrar (Esc)">
                    <i class="fas fa-xmark text-base"></i>
                </button>
            </div>
        </div>

        <!-- Viewport / Área de Trabajo A4 con Zoom y Arrastre -->
        <div id="sat-modal-viewport" class="relative flex-1 overflow-hidden bg-slate-950 flex items-center justify-center p-3 select-none touch-none cursor-grab active:cursor-grabbing">
            <div id="sat-modal-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-slate-950/85 backdrop-blur-xs z-30">
                <i class="fas fa-circle-notch fa-spin text-3xl text-blue-500"></i>
                <span class="text-xs font-semibold text-slate-300">Cargando copia oficial en alta resolución...</span>
            </div>

            <!-- Hoja A4 estilizada con sombras realistas -->
            <div id="sat-a4-sheet" class="relative bg-white shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] rounded-xs border border-slate-300/80 transition-transform duration-100 ease-out origin-center overflow-hidden flex flex-col items-center justify-center" style="width: min(100%, 750px); max-height: 100%;">
                <img id="sat-modal-img" src="" alt="Copia oficial de papeleta SAT" class="w-full h-auto object-contain block max-h-full pointer-events-none hidden" />
                <iframe id="sat-modal-frame" src="" class="w-full h-[70vh] border-0 hidden bg-white"></iframe>
            </div>

            <!-- Píldora de ayuda/zoom en flotante -->
            <div class="absolute bottom-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-slate-900/80 backdrop-blur-md border border-slate-700/60 text-slate-300 text-[10px] pointer-events-none hidden sm:flex items-center gap-1.5 shadow-lg z-20">
                <i class="fas fa-hand-pointer text-[9px] text-blue-400"></i> Arrastra para desplazarte · Rueda o pellizca para Zoom
            </div>
        </div>

        <!-- Footer del Modal -->
        <div class="px-4 sm:px-6 py-2 bg-slate-900 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400 z-20">
            <span class="flex items-center gap-1.5"><i class="fas fa-shield-halved text-emerald-400"></i> Documento verificado desde servidor oficial SAT Lima</span>
            <button type="button" id="sat-modal-close-footer" class="text-slate-400 hover:text-white font-extrabold uppercase tracking-wider text-[10px] cursor-pointer">
                Volver a la Consulta
            </button>
        </div>
    </div>
</div>

<!-- Modal Oficial de Visualización de Acta de Fiscalización ATU -->
<div id="atu-acta-modal" class="fixed inset-0 z-[99999] hidden items-center justify-center p-3 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-all duration-300">
    <div class="relative w-full max-w-4xl bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden flex flex-col max-h-[90vh] font-poppins">
        <!-- Header del Modal -->
        <div class="flex items-center justify-between px-4 sm:px-6 py-3.5 bg-slate-900 text-white border-b border-slate-800">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-sky-500/20 border border-sky-400/30 flex items-center justify-center text-sky-400">
                    <i class="fas fa-file-pdf text-sm"></i>
                </div>
                <div>
                    <h3 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-white">Acta Oficial de Fiscalización ATU</h3>
                    <p class="text-[10px] text-slate-400 font-mono" id="atu-modal-doc-title">Documento: —</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a id="atu-modal-download-btn" href="#" download="Acta_ATU.pdf" target="_blank" rel="noopener"
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs uppercase tracking-wider transition-all shadow-xs active:scale-95 cursor-pointer">
                    <i class="fas fa-download text-xs"></i> <span class="hidden sm:inline">Descargar PDF</span>
                </a>
                <button type="button" id="atu-modal-close-btn" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all active:scale-95 cursor-pointer" title="Cerrar (Esc)">
                    <i class="fas fa-xmark text-base"></i>
                </button>
            </div>
        </div>

        <!-- Contenido / Visualizador -->
        <div class="relative flex-1 overflow-auto p-3 sm:p-5 flex items-center justify-center bg-slate-100 dark:bg-slate-950 min-h-[400px]">
            <div id="atu-modal-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs z-10">
                <i class="fas fa-circle-notch fa-spin text-2xl text-sky-600"></i>
                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Cargando acta oficial desde la pasarela ATU...</span>
            </div>
            <div id="atu-modal-error" class="hidden flex-col items-center justify-center gap-2 text-center p-6">
                <i class="fas fa-triangle-exclamation text-3xl text-rose-500"></i>
                <p class="text-sm font-extrabold text-slate-800 dark:text-slate-200">No se pudo cargar la vista previa del acta</p>
                <p id="atu-modal-error-msg" class="text-xs text-slate-500">Puedes intentar descargar el archivo directamente con el botón superior.</p>
            </div>
            <div id="atu-modal-canvas-viewer" class="hidden w-full max-h-[68vh] overflow-auto rounded-lg bg-slate-200 p-2"></div>
            <iframe id="atu-modal-frame" src="about:blank" class="w-full h-[68vh] rounded-lg border border-slate-200 dark:border-slate-800 hidden"></iframe>
        </div>

        <!-- Footer del Modal -->
        <div class="px-4 sm:px-6 py-2.5 bg-slate-50 dark:bg-slate-900/90 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
            <span class="flex items-center gap-1.5"><i class="fas fa-shield-halved text-emerald-500"></i> Documento oficial ATU emitido por la autoridad</span>
            <button type="button" id="atu-modal-close-footer" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white font-extrabold uppercase tracking-wider text-[10px] cursor-pointer">
                Volver a la Consulta
            </button>
        </div>
    </div>
</div>

        // ====================================================
        // PETICIONES INDEPENDIENTES
        // ====================================================
        async function fetchSOAT(plate: string) {
            setCardLoading('soat', 'SOAT', 'Seguro Obligatorio de Accidentes de Tránsito', 'fas fa-shield-halved', '', 'APESEG');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);
            try {
                const res = await fetch(`${BACKEND_URL}/soat/${plate}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data.success) {
                    const content = renderSOAT(data.data, plate);
                    setCardData('soat', 'SOAT', '', 'fas fa-shield-halved', '', 'APESEG', content, true, data.data?.length > 0);
                } else {
                    setCardError('soat', 'SOAT', '', 'fas fa-shield-halved', '', 'APESEG', data.error || 'Error desconocido', plate);
                }
            } catch (err: any) {
                clearTimeout(timeoutId);
                const msg = err.name === 'AbortError' ? 'Tiempo de espera agotado (30s).' : (err.message || 'Error de conexión');
                setCardError('soat', 'SOAT', '', 'fas fa-shield-halved', '', 'APESEG', msg, plate);
            }
        }

        async function fetchCITV(plate: string) {
            setCardLoading('citv', 'CITV', '', 'fas fa-clipboard-check', '', 'MTC');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 130000);
            try {
                const res = await fetch(`${BACKEND_URL}/citv/${plate}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data.success) {
                    const content = renderCITV(data.data, plate);
                    setCardData('citv', 'CITV', '', 'fas fa-clipboard-check', '', 'MTC', content, true, data.data?.length > 0);
                } else {
                    setCardError('citv', 'CITV', '', 'fas fa-clipboard-check', '', 'MTC', data.error || 'Error de captcha MTC', plate);
                }
            } catch (err: any) {
                clearTimeout(timeoutId);
                const msg = err.name === 'AbortError' ? 'Tiempo de espera agotado (35s).' : (err.message || 'Error de conexión');
                setCardError('citv', 'CITV', '', 'fas fa-clipboard-check', '', 'MTC', msg, plate);
            }
        }


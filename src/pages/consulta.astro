---
// Vista de consulta específica por placa - Integrada con el Backend real
---

<!DOCTYPE html>
<html lang="es" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consulta por Placa - Análisis Vehicular Perú</title>
    <meta name="description" content="Consulta en tiempo real el estado de SOAT y CITV de cualquier vehículo peruano ingresando su placa.">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Dancing+Script:wght@700&family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes shimmer {
            0%   { background-position: -600px 0; }
            100% { background-position: 600px 0; }
        }
        @keyframes pulseRing {
            0%   { box-shadow: 0 0 0 0 rgba(234,179,8,0.35); }
            70%  { box-shadow: 0 0 0 10px rgba(234,179,8,0); }
            100% { box-shadow: 0 0 0 0 rgba(234,179,8,0); }
        }
        .card-animate { animation: fadeSlideIn 0.4s ease both; }
        .skeleton {
            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
            background-size: 600px 100%;
            animation: shimmer 1.5s infinite linear;
            border-radius: 6px;
        }
        .spin-icon { animation: spin 1.2s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .results-card { transition: box-shadow 0.25s ease, transform 0.2s ease; }
        .results-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.10); transform: translateY(-1px); }
    </style>

</head>

<body class="bg-slate-50 dark:bg-brand-navy-dark text-slate-800 dark:text-white transition-colors duration-300 min-h-screen font-inter flex flex-col pb-10">

    {/* Header / Barra de Navegación */}
    <header class="w-full max-w-[1100px] flex justify-between items-center px-5 py-4 mx-auto md:px-[15px] z-20">
        <a
            href="/"
            class="px-4 py-2 rounded-lg bg-slate-200 dark:bg-white/10 text-slate-700 dark:text-white hover:bg-slate-300 dark:hover:bg-white/20 transition-all duration-300 flex items-center gap-2 text-xs md:text-sm font-semibold shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-yellow/50 active:scale-95"
        >
            <i class="fas fa-arrow-left"></i> Volver al Dashboard
        </a>
        
        <button
            id="theme-toggle"
            class="p-2.5 rounded-full bg-slate-200 dark:bg-white/10 text-slate-700 dark:text-white hover:bg-slate-300 dark:hover:bg-white/20 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-yellow/50"
            aria-label="Cambiar tema"
        >
            <i id="theme-toggle-icon" class="fas fa-moon text-lg transition-transform duration-300 hover:rotate-12"></i>
        </button>
    </header>

    <main class="w-full flex-1 flex flex-col items-center">
        {/* Banner Section */}
        <section class="w-full bg-[radial-gradient(circle,_#1a3a6b_0%,_#0b1c36_100%)] border-y border-white/5 px-5 py-8 md:py-4 md:px-2 flex justify-center items-center overflow-hidden relative">
            <div class="max-w-[1100px] w-full flex flex-row flex-wrap md:flex-nowrap justify-between items-center gap-3 md:gap-5 px-0 md:px-2.5">
                
                <img
                    src="/assets/fortuner.png"
                    alt="Toyota Fortuner"
                    class="hidden md:block car-img order-1 md:order-1 max-w-[280px] h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] z-10 -ml-5 transition-transform duration-500 hover:scale-105"
                />

                {/* Contenido Central */}
                <div class="banner-content order-3 md:order-2 text-center flex-1 z-10 w-full md:w-auto -mt-2 md:mt-0 px-2">
                    <h1 class="text-brand-yellow font-archivo text-[36px] md:text-[55px] italic leading-[0.9] m-0 tracking-[-1.5px] md:tracking-[-2px] drop-shadow-[2px_2px_0px_rgba(0,0,0,0.5)] uppercase">
                        CONSULTA
                    </h1>
                    <div class="text-brand-yellow font-dancing text-[26px] md:text-[38px] -my-[3px] flex justify-center items-center gap-2">
                        <span>de tu</span>
                        <span class="text-white">Vehículo</span>
                        <span class="text-white/80 font-normal font-sans text-lg md:text-2xl">por</span>
                        <span>Placa</span>
                    </div>
                    
                    <p class="text-white/95 text-xs md:text-sm mt-3.5 font-medium tracking-wide">
                        Ingresa el número de placa para consultar SOAT y CITV en tiempo real
                    </p>

                    {/* Módulo de Búsqueda */}
                    <form id="query-form" class="mt-5 max-w-[340px] mx-auto bg-white/10 dark:bg-white/5 border border-white/20 p-2 rounded-xl flex items-center gap-2 shadow-lg focus-within:ring-2 focus-within:ring-brand-yellow/50 transition-all duration-300">
                        <input
                            type="text"
                            id="plate-search-input"
                            placeholder="ABC-123"
                            maxlength="9"
                            class="bg-transparent border-0 font-archivo text-xl text-white font-bold placeholder-white/30 uppercase text-center w-full focus:ring-0 focus:outline-none"
                            required
                            aria-label="Ingresa tu placa vehicular para consultar"
                        />
                        <button
                            type="submit"
                            id="submit-btn"
                            class="bg-brand-yellow hover:bg-[#ffd000]/80 text-brand-navy-dark px-4 py-2 rounded-lg transition-all duration-300 font-extrabold flex items-center gap-1.5 active:scale-95 whitespace-nowrap text-xs shadow-md"
                        >
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </form>
                    
                    <p
                        id="query-status"
                        class="text-xs text-brand-yellow mt-2 font-medium opacity-0 transition-opacity duration-300 pointer-events-none"
                    >
                        &nbsp;
                    </p>
                </div>

                <img
                    src="/assets/hilux.png"
                    alt="Toyota Hilux"
                    class="hidden md:block car-img order-2 md:order-3 max-w-[280px] h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] z-10 -mr-5 transition-transform duration-500 hover:scale-105"
                />
            </div>
        </section>

        {/* Backend Status Banner */}
        <div id="backend-status-banner" class="hidden w-full bg-amber-500/10 border-b border-amber-500/30 px-5 py-2.5 text-center">
            <p class="text-amber-400 text-xs font-semibold">
                <i class="fas fa-exclamation-triangle mr-1"></i>
                Backend no disponible en este momento. El servidor de consultas está iniciando, por favor espera unos segundos e intenta de nuevo.
            </p>
        </div>

        {/* Sección de Resultados */}
        <div class="w-full max-w-[1100px] mt-8 px-5 md:px-[15px] z-10">
            <div class="flex items-center gap-3 text-slate-800 dark:text-white border-b border-slate-200 dark:border-white/10 pb-2 mb-6">
                <i class="fas fa-chart-line text-brand-red dark:text-brand-yellow text-xl"></i>
                <h2 class="text-xl font-bold tracking-wide font-inter">Resultados del Análisis</h2>
            </div>
            
            {/* Estado inicial */}
            <div
                id="results-container"
                class="w-full max-w-xl mx-auto text-center py-12 px-6 rounded-2xl border border-dashed border-slate-200 bg-white shadow-md text-slate-900"
            >
                <i class="fas fa-folder-open text-4xl text-slate-300 mb-3.5 block"></i>
                <p class="font-extrabold text-slate-700 text-lg">Esperando Datos</p>
                <p class="text-xs text-slate-500 mt-1 max-w-[300px] mx-auto leading-relaxed">
                    Ingresa una placa arriba para consultar el SOAT y CITV de ese vehículo en tiempo real.
                </p>
            </div>
        </div>

    </main>

    {/* Footer */}
    <footer class="mt-16 py-10 px-5 bg-slate-100 dark:bg-[#0b1c36]/90 backdrop-blur-md border-t border-slate-200 dark:border-brand-red/20 text-center w-full">
        <div class="max-w-[1100px] mx-auto">
            <p class="text-xs text-slate-400 dark:text-text-muted mb-1.5 uppercase tracking-widest">Realizado por:</p>
            <p class="text-lg md:text-xl font-extrabold text-slate-800 dark:text-white mb-5">Luis Antony Huamani Gonzales</p>
        </div>
    </footer>

                    <script>
        // ====================================================
        // CONFIG
        // ====================================================
        const BACKEND_URL = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:8000/api/v1';

        // ====================================================
        // TEMA
        // ====================================================
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-toggle-icon');

        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                if (themeIcon) themeIcon.className = 'fas fa-sun text-brand-yellow text-lg transition-transform duration-500 hover:rotate-45';
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                if (themeIcon) themeIcon.className = 'fas fa-moon text-slate-700 text-lg transition-transform duration-500 hover:rotate-12';
            }
        }

        const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        applyTheme(savedTheme);
        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                applyTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark');
            });
        }

        // ====================================================
        // FORMATO DE PLACA
        // ====================================================
        const plateInput = document.getElementById('plate-search-input') as HTMLInputElement;
        if (plateInput) {
            plateInput.addEventListener('input', () => {
                let val = plateInput.value.replace(/[^A-Za-z0-9-]/g, '').toUpperCase();
                const cleanVal = val.replace(/-/g, '');
                if (cleanVal.length === 6 && !val.includes('-')) {
                    val = cleanVal.slice(0, 3) + '-' + cleanVal.slice(3);
                }
                plateInput.value = val;
            });
        }

        // ====================================================
        // VERIFICAR BACKEND AL CARGAR
        // ====================================================
        async function checkBackend() {
            const healthUrl = BACKEND_URL.replace('/api/v1', '') + '/health';
            try {
                const res = await fetch(healthUrl, { signal: AbortSignal.timeout(5000) });
                if (!res.ok) throw new Error();
                document.getElementById('backend-status-banner')?.classList.add('hidden');
            } catch {
                const bannerText = document.querySelector('#backend-status-banner p');
                if (bannerText) {
                    const displayUrl = healthUrl.replace('/health', '');
                    bannerText.innerHTML = `<i class="fas fa-exclamation-triangle mr-1"></i> Backend no disponible en este momento. Asegúrate de que el servidor esté activo en <code class="bg-black/20 px-1 rounded">${displayUrl}</code>`;
                }
                document.getElementById('backend-status-banner')?.classList.remove('hidden');
            }
        }
        checkBackend();

        // ====================================================
        // ORDENAMIENTO DINÁMICO DE TARJETAS
        // ====================================================
        function reorderCards() {
            const wrapper = document.getElementById('results-cards-wrapper');
            if (!wrapper) return;
            const cards = Array.from(wrapper.children);
            const statusOrder: Record<string, number> = {
                'funciona': 1,
                'loading': 2,
                'no-funciona': 3,
                'mantenimiento': 4
            };
            cards.sort((a: any, b: any) => {
                if (a.id === 'lima-card-container' && b.id !== 'lima-card-container') return 1;
                if (b.id === 'lima-card-container' && a.id !== 'lima-card-container') return -1;
                const statusA = a.getAttribute('data-status') || 'loading';
                const statusB = b.getAttribute('data-status') || 'loading';
                const orderA = statusOrder[statusA] ?? 2;
                const orderB = statusOrder[statusB] ?? 2;
                if (orderA !== orderB) return orderA - orderB;
                const defaultOrder = ['soat-card-container','citv-card-container','lunas-card-container','callao-card-container','sutran-card-container','atu-card-container'];
                return defaultOrder.indexOf(a.id) - defaultOrder.indexOf(b.id);
            });
            cards.forEach(card => wrapper.appendChild(card));
        }

        // ====================================================
        // SKELETON LOADER  (shimmer blocks)
        // ====================================================
        function skeletonBody() {
            return `
                <div class="flex flex-col gap-3 pt-1">
                    <div class="skeleton h-4 w-2/3"></div>
                    <div class="skeleton h-3 w-1/2"></div>
                    <div class="skeleton h-3 w-3/4"></div>
                    <div class="skeleton h-3 w-1/3"></div>
                    <div class="skeleton h-3 w-2/3"></div>
                </div>`;
        }

        // ====================================================
        // COLOR PALETTE POR SERVICIO
        // ====================================================
        const SERVICE_COLORS: Record<string, { bg: string; icon: string; ring: string }> = {
            soat:   { bg: 'bg-blue-50',   icon: 'text-blue-600',  ring: 'ring-blue-200' },
            citv:   { bg: 'bg-emerald-50', icon: 'text-emerald-600', ring: 'ring-emerald-200' },
            lunas:  { bg: 'bg-purple-50',  icon: 'text-purple-600', ring: 'ring-purple-200' },
            callao: { bg: 'bg-red-50',     icon: 'text-red-600',   ring: 'ring-red-200' },
            lima:   { bg: 'bg-amber-50',   icon: 'text-amber-600', ring: 'ring-amber-200' },
            sutran: { bg: 'bg-orange-50',  icon: 'text-orange-600',ring: 'ring-orange-200' },
            atu:    { bg: 'bg-teal-50',    icon: 'text-teal-600',  ring: 'ring-teal-200' },
        };

        function getColors(cardId: string) {
            return SERVICE_COLORS[cardId] || { bg: 'bg-slate-50', icon: 'text-slate-600', ring: 'ring-slate-200' };
        }

        // ====================================================
        // BADGE DE ESTADO
        // ====================================================
        function estadoBadge(estado: string) {
            const s = (estado || '').toUpperCase();
            if (s === 'VIGENTE' || s === 'APROBADO' || s === 'APROBADA') {
                return `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 shadow-sm">
                    <i class="fas fa-circle-check"></i> ${estado}
                </span>`;
            }
            return `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-300 shadow-sm">
                <i class="fas fa-circle-xmark"></i> ${estado || 'VENCIDO'}
            </span>`;
        }

        // ====================================================
        // FILA DE TABLA (label + value)
        // ====================================================
        function fila(label: string, value: string) {
            if (!value || value === 'null' || value === 'undefined' || value.trim() === '') return '';
            return `<tr class="flex flex-col md:table-row border-b border-slate-200 last:border-0 hover:bg-slate-50/80 transition-colors duration-150 group">
                <td class="py-2.5 px-3 md:py-3 md:px-4 text-[10px] md:text-[11px] font-extrabold text-slate-400 uppercase tracking-wider bg-slate-50 border-b md:border-b-0 md:border-r-2 border-slate-200 whitespace-normal md:whitespace-nowrap w-full md:w-[38%] group-hover:bg-slate-100 transition-colors">${label}</td>
                <td class="py-2.5 px-3 md:py-3 md:px-4 text-xs md:text-sm font-bold text-slate-800 leading-snug w-full md:w-auto">${value}</td>
            </tr>`;
        }

        // ====================================================
        // HEADER DE TARJETA REUTILIZABLE
        // ====================================================
        function cardHeader(cardId: string, title: string, sourceName: string, iconClass: string, badgeHTML: string) {
            const c = getColors(cardId);
            return `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 w-full">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 md:w-12 md:h-12 rounded-2xl ${c.bg} ring-2 ${c.ring} flex items-center justify-center shrink-0 shadow-sm">
                            <i class="${iconClass} ${c.icon} text-base md:text-lg"></i>
                        </div>
                        <div>
                            <h3 class="font-extrabold text-slate-900 text-xs md:text-base leading-tight uppercase tracking-wide font-archivo">${title}</h3>
                            <p class="text-[9px] md:text-[10px] text-slate-400 font-bold tracking-widest uppercase mt-0.5">${sourceName}</p>
                        </div>
                    </div>
                    <div class="self-start sm:self-auto shrink-0">${badgeHTML}</div>
                </div>
                <div class="border-t-2 border-slate-100 w-full my-1"></div>`;
        }

        // ====================================================
        // SET CARD LOADING — Skeleton premium
        // ====================================================
        function setCardLoading(cardId: string, title: string, sub: string, iconClass: string, bgColorClass: string, sourceName: string) {
            const container = document.getElementById(`${cardId}-card-container`);
            if (!container) return;
            container.setAttribute('data-status', 'loading');
            container.className = "results-card card-animate bg-white border-2 border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm flex flex-col gap-4 text-slate-900";
            const loadingBadge = `<span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-500 border border-slate-200">
                <span class="inline-block w-3 h-3 rounded-full border-2 border-slate-400 border-t-transparent spin-icon"></span> Consultando...
            </span>`;
            container.innerHTML = `
                ${cardHeader(cardId, title, sourceName, iconClass, loadingBadge)}
                <div class="space-y-3">
                    ${skeletonBody()}
                    <div class="flex items-center gap-2 pt-2">
                        <div class="skeleton h-3 w-1/4"></div>
                        <div class="skeleton h-3 w-1/3"></div>
                    </div>
                </div>`;
            reorderCards();
        }

        // ====================================================
        // SET CARD DATA
        // ====================================================
        function setCardData(cardId: string, title: string, sub: string, iconClass: string, bgColorClass: string, sourceName: string, htmlContent: string, isSuccess: boolean, hasData: boolean) {
            const container = document.getElementById(`${cardId}-card-container`);
            if (!container) return;
            let badgeHTML = '';
            if (isSuccess) {
                container.setAttribute('data-status', 'funciona');
                if (hasData) {
                    badgeHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 shadow-sm">
                        <i class="fas fa-circle-check text-emerald-500"></i> Con Registros
                    </span>`;
                } else {
                    badgeHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-slate-50 text-slate-600 border border-slate-300 shadow-sm">
                        <i class="fas fa-circle-info text-slate-400"></i> Sin Registros
                    </span>`;
                }
            } else {
                container.setAttribute('data-status', 'mantenimiento');
                badgeHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-300 shadow-sm animate-pulse">
                    <i class="fas fa-triangle-exclamation text-amber-500"></i> Mantenimiento
                </span>`;
            }
            container.className = "results-card card-animate bg-white border-2 border-slate-900 rounded-2xl p-5 md:p-6 shadow-md flex flex-col gap-4 text-slate-900";
            container.innerHTML = `
                ${cardHeader(cardId, title, sourceName, iconClass, badgeHTML)}
                <div class="w-full">${htmlContent}</div>`;
            reorderCards();
        }

        // ====================================================
        // SET CARD ERROR
        // ====================================================
        function setCardError(cardId: string, title: string, sub: string, iconClass: string, bgColorClass: string, sourceName: string, errorMessage: string, plate: string) {
            const container = document.getElementById(`${cardId}-card-container`);
            if (!container) return;
            const isMantenimiento = (errorMessage || "").toLowerCase().includes("mantenimiento");
            let badgeHTML = '';
            let rightContent = '';
            if (isMantenimiento) {
                container.setAttribute('data-status', 'mantenimiento');
                badgeHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-300 shadow-sm">
                    <i class="fas fa-wrench text-amber-500"></i> Mantenimiento
                </span>`;
                rightContent = `
                    <div class="flex flex-col items-center justify-center text-center gap-3 py-6">
                        <div class="w-14 h-14 rounded-full bg-amber-50 border-2 border-amber-200 flex items-center justify-center mb-1">
                            <i class="fas fa-wrench text-2xl text-amber-500 animate-pulse"></i>
                        </div>
                        <div>
                            <p class="text-sm font-extrabold text-slate-800 leading-tight">Servicio en Mantenimiento</p>
                            <p class="text-xs text-slate-400 mt-1 max-w-[300px] mx-auto leading-relaxed">${errorMessage}</p>
                        </div>
                        <button onclick="window.reintentarSeccion('${cardId}', '${plate}')"
                            class="mt-1 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-700 text-white text-xs font-extrabold uppercase tracking-wide transition-all duration-200 active:scale-95 shadow-md hover:shadow-lg">
                            <i class="fas fa-rotate-right"></i> Reintentar Consulta
                        </button>
                    </div>`;
            } else {
                container.setAttribute('data-status', 'no-funciona');
                badgeHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-300 shadow-sm">
                    <i class="fas fa-circle-xmark text-red-500"></i> Sin Acceso
                </span>`;
                rightContent = `
                    <div class="flex flex-col items-center justify-center text-center gap-3 py-6">
                        <div class="w-14 h-14 rounded-full bg-red-50 border-2 border-red-200 flex items-center justify-center mb-1">
                            <i class="fas fa-circle-xmark text-2xl text-red-500"></i>
                        </div>
                        <div>
                            <p class="text-sm font-extrabold text-red-700 leading-tight">Error al conectar con la fuente</p>
                            <p class="text-xs text-slate-400 mt-1 max-w-[300px] mx-auto leading-relaxed">${errorMessage}</p>
                        </div>
                        <button onclick="window.reintentarSeccion('${cardId}', '${plate}')"
                            class="mt-1 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-extrabold uppercase tracking-wide transition-all duration-200 active:scale-95 shadow-md hover:shadow-lg">
                            <i class="fas fa-rotate-right"></i> Reintentar Consulta
                        </button>
                    </div>`;
            }
            container.className = "results-card card-animate bg-white border-2 border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm flex flex-col gap-4 text-slate-900";
            container.innerHTML = `
                ${cardHeader(cardId, title, sourceName, iconClass, badgeHTML)}
                <div class="w-full">${rightContent}</div>`;
            reorderCards();
        }

        // ====================================================
        // RENDER SOAT
        // ====================================================
        function renderSOAT(data: any[], plate: string) {
            if (!data || data.length === 0) {
                return `<div class="flex flex-col items-center justify-center py-8 gap-2 text-center">
                    <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mb-1">

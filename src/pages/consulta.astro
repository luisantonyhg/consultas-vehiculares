                    <p class="text-[11px] text-slate-400 dark:text-slate-500">Datos obtenidos en tiempo real · Última consulta: <strong class="text-slate-600 dark:text-slate-400 font-poppins">${plate}</strong> · <span id="last-query-time"></span></p>
                </div>`;
            
            if (!fromCache) {
                setCardLoading('sunarp', 'Información Registro SUNARP', 'Superintendencia de los Registros Públicos', 'fas fa-file-contract', '', 'SUNARP');
                
                // Mostrar inmediatamente las secciones iniciales
                setCardLoading('soat', 'SOAT', '', 'fas fa-shield-halved', '', 'APESEG');
                setCardLoading('citv', 'Inspección Técnica Vehicular', '', 'fas fa-clipboard-check', '', 'MTC');
                setCardLoading('gnv', 'Gas Natural Vehicular (GNV)', '', 'fas fa-fire-flame-curved', '', 'Infogas');
                setCardLoading('fise', 'Deuda GNV (FISE Ahorro GNV)', 'Programa Ahorro GNV - MINEM', 'fas fa-gas-pump', '', 'FISE MINEM');
                setCardLoading('callao', 'Papeletas Callao', '', 'fas fa-ticket', '', 'Mun. Callao');
                setCardLoading('sutran', 'Papeletas SUTRAN', '', 'fas fa-road', '', 'SUTRAN');
                setCardLoading('cinemometro', 'Cinemómetro SUTRAN', 'Papeletas de velocidad', 'fas fa-gauge-high', '', 'SUTRAN');
                setCardLoading('municipal', 'Papeletas Otras Municipalidades', 'Provincias del Perú', 'fas fa-building-columns', '', 'Municipalidades');
                setCardLoading('placas_pe', 'Registro Vehicular AAP', 'Estado de Placa', 'fas fa-car', '', 'AAP');
                setCardLoading('valor_venal', 'Valor Comercial Referencial', 'APESEG', 'fas fa-tag', '', 'APESEG');
                setCardLoading('osinergmin', 'Registro Oficial de Tanque / Hidrocarburos', 'OSINERGMIN', 'fas fa-gas-pump', '', 'OSINERGMIN');

                setCardWaiting('atu', 'Habilitación Taxi ATU', '', 'fas fa-taxi', '', 'ATU', 'En espera (Turno 1)');
                setCardWaiting('sbs', 'Siniestralidad Vehicular', 'SOAT · Vehicular · CAT', 'fas fa-car-burst', '', 'SBS', 'En espera (Turno 2)');
                setCardWaiting('sat_captura', 'Orden de Captura (SAT)', 'Provincia de Lima', 'fas fa-gavel', '', 'SAT Lima', 'En espera (Turno 3)');
                setCardWaiting('sat_deposito', 'Internamiento en Depósito (SAT)', '', 'fas fa-warehouse', '', 'SAT Lima', 'En espera (Turno 3)');
                setCardWaiting('sat_deuda', 'Deuda Imp. Vehicular (SAT)', 'Impuesto Vehicular', 'fas fa-file-invoice-dollar', '', 'SAT Lima', 'En espera (Turno 3)');
                setCardWaiting('lunas', 'Lunas Oscurecidas', 'Captcha PNP', 'fas fa-eye-slash', '', 'PNP', 'En espera (Turno 4)');
                setCardWaiting('pnp_req', 'Requisitorias Policiales (PNP)', 'Captura vehicular', 'fas fa-shield-halved', '', 'PNP Tránsito', 'En espera (Turno 5)');
                setCardWaiting('lima', 'Papeletas Lima (SAT)', 'reCAPTCHA v2', 'fas fa-traffic-light', '', 'SAT Lima', 'En espera (Turno 6 · final)');
                initHistorialDueñosCard(plate, { setCardData });

                const lastQueryTimeEl = document.getElementById('last-query-time');
                if (lastQueryTimeEl) {
                    lastQueryTimeEl.textContent = new Date().toLocaleString('es-PE');
                }
            }
        }

        // ====================================================
        // SUBMIT DEL FORMULARIO
        // ====================================================
        const queryForm = document.getElementById('query-form');
        const queryStatus = document.getElementById('query-status');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

        if (queryForm && plateInput && queryStatus) {
            queryForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const plate = plateInput.value.trim().toUpperCase();
                if (!plate) return;

                // Validar formato de placa peruana (ej. ABC-123 o A1B-234)
                const cleanPlate = plate.replace(/-/g, '').replace(/\s/g, '');
                const plateRegex = /^[A-Z0-9]{6}$/;
                if (!plateRegex.test(cleanPlate)) {
                    queryStatus.innerHTML = '<span class="text-rose-500 font-bold"><i class="fas fa-circle-exclamation mr-1"></i>Placa inválida. Formato esperado: ABC-123 o A1B-234</span>';
                    queryStatus.classList.remove('opacity-0');
                    return;
                }

                const captchaInput = document.getElementById('captcha-input') as HTMLInputElement;

                // Intentar cargar desde localStorage (Caché inteligente de 5 min)
                const isLoadedFromCache = loadFromCache(plate);
                if (isLoadedFromCache) {
                    if (captchaInput) captchaInput.value = '';
                    drawCaptcha();
                    fillValorVenalSoles();
                    queryStatus.classList.add('opacity-0');
                    return;
                }

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Consultando...';
                }
                queryStatus.textContent = 'Iniciando consulta multiorigen...';
                queryStatus.classList.remove('opacity-0');

                // Reset vehicle info
                vehicleData = {};

                if (captchaInput) captchaInput.value = '';
                drawCaptcha();

                renderResultsSkeleton(plate, false);

                if (window.innerWidth < 900) {
                    requestAnimationFrame(() => requestAnimationFrame(() => {
                        setTimeout(() => {
                            const resultsSection = document.getElementById('results-section');
                            if (resultsSection) {
                                const y = resultsSection.getBoundingClientRect().top + window.scrollY - 12;
                                window.scrollTo({ top: y, behavior: 'smooth' });
                            }
                        }, 250);
                    }));
                }

                // ====================================================
                // EJECUCIÓN EN 2 FASES
                // Fase 1: Servicios ligeros (HTTP directo) → en paralelo
                // Fase 2: Servicios pesados (Chromium) → secuencial
                // ====================================================
                (async () => {
                    try {
                        // Verificación rápida de disponibilidad del backend (Health endpoint está en raíz /health)
                        try {
                            const baseUrl = BACKEND_URL.replace(/\/api\/v1\/?$/, '');
                            const healthRes = await fetch(`${baseUrl}/health`, { signal: AbortSignal.timeout(10000) });
                            if (!healthRes.ok) throw new Error("HTTP Status " + healthRes.status);
                        } catch (_healthErr) {
                            console.warn("[CONEXION] Health check aviso (continuando consulta):", _healthErr);
                        }

                        // FASE 1: Servicios ligeros en paralelo (HTTP directo y consultas rápidas)
                        queryStatus.textContent = 'Fase 1: Consultando servicios rápidos...';
                        await Promise.all([
                            fetchSUNARP(plate),
                            fetchSOAT(plate),
                            fetchCITV(plate),
                            fetchGNV(plate),
                            fetchFISE(plate),
                            fetchCallao(plate),
                            fetchSutran(plate),
                            fetchCinemometro(plate),
                            fetchMunicipal(plate),
                            fetchEstadoPlacaYValor(plate),
                            fetchOsinergmin(plate),
                        ]);

                        // FASE 2: Servicios pesados secuencial (usan Chromium / Captchas complejos)
                        queryStatus.textContent = 'Fase 2: Consultando servicios avanzados...';

                        // Estado visual bonito para la cola secuencial
                        setCardWaiting('sbs', 'Siniestralidad Vehicular', 'SOAT · Vehicular · CAT', 'fas fa-car-burst', '', 'SBS', 'En turno (Iniciando...)');
                        setCardWaiting('sat_captura', 'Orden de Captura (SAT)', 'Provincia de Lima', 'fas fa-gavel', '', 'SAT Lima', 'En espera (Turno 2)');
                        setCardWaiting('sat_deposito', 'Internamiento en Depósito (SAT)', '', 'fas fa-warehouse', '', 'SAT Lima', 'En espera (Turno 2)');
                        setCardWaiting('sat_deuda', 'Deuda Imp. Vehicular (SAT)', 'Impuesto Vehicular', 'fas fa-file-invoice-dollar', '', 'SAT Lima', 'En espera (Turno 2)');
                        setCardWaiting('lima', 'Papeletas Lima (SAT)', 'reCAPTCHA v2', 'fas fa-traffic-light', '', 'SAT Lima', 'En espera (Turno 3)');
                        setCardWaiting('pnp_req', 'Requisitorias Policiales (PNP)', 'Captura vehicular', 'fas fa-shield-halved', '', 'PNP Tránsito', 'En espera (Turno 4)');
                        setCardWaiting('lunas', 'Lunas Oscurecidas', 'Captcha PNP', 'fas fa-eye-slash', '', 'PNP', 'En espera (Turno 5)');
                        setCardWaiting('atu', 'Habilitación Taxi ATU', '', 'fas fa-taxi', '', 'ATU', 'En espera (Turno 6 · Final)');

                        // 1. SBS Siniestralidad
                        await fetchSBS(plate);

                        // 2. SAT (orden de captura + internamiento + deuda) — navegador compartido
                        await fetchSAT(plate);

                        // 3. SAT LIMA (Papeletas reCAPTCHA v2 - VirtualSAT)
                        setCardLoading('lima', 'Papeletas Lima (SAT)', 'Consultando papeletas SAT...', 'fas fa-traffic-light', '', 'SAT Lima');
                        await fetchLima(plate);

                        // 4. PNP REQUISITORIAS (Captura Vehicular)
                        setCardLoading('pnp_req', 'Requisitorias Policiales (PNP)', 'Consultando órdenes de captura PNP...', 'fas fa-shield-halved', '', 'PNP Tránsito');
                        await fetchPNP(plate);

                        // 5. LUNAS (PNP BotDetect Captcha)
                        setCardLoading('lunas', 'Lunas Oscurecidas', 'Resolviendo captcha PNP...', 'fas fa-eye-slash', '', 'PNP');
                        await fetchLunas(plate);

                        // 6. ATU (Habilitación Taxi - al final para no hacer esperar al usuario)
                        setCardLoading('atu', 'Habilitación Taxi ATU', 'Verificando habilitación de taxi ATU...', 'fas fa-taxi', '', 'ATU');
                        await fetchATU(plate);

                        // Guardar snapshot de resultados en localStorage
                        saveToCache(plate);
                    } catch (err) {
                        console.error('[FASES] Error general en ejecución por fases:', err);
                    } finally {
                        queryStatus.classList.add('opacity-0');
                        if (submitBtn) {
                            let cooldown = 10;
                            const interval = setInterval(() => {
                                if (cooldown > 0) {
                                    submitBtn.disabled = true;
                                    submitBtn.innerHTML = `<i class="fas fa-clock"></i> Esperar ${cooldown}s`;
                                    cooldown--;
                                } else {
                                    clearInterval(interval);
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = '<i class="fas fa-search"></i> Buscar';
                                }
                            }, 1000);
                            submitBtn.disabled = true;
                            submitBtn.innerHTML = `<i class="fas fa-clock"></i> Esperar ${cooldown}s`;
                            cooldown--;
                        }
                    }
                })();
            });
        }

        (window as any).abrirModalPapeleta = async function(nroPapeleta: string) {
            const modal = document.getElementById('papeleta-modal')!;
            const title = document.getElementById('modal-papeleta-title')!;
            const loading = document.getElementById('modal-loading')!;
            const error = document.getElementById('modal-error')!;
            const errorMsg = document.getElementById('modal-error-msg')!;
            const pdfViewer = document.getElementById('pdf-viewer') as HTMLIFrameElement;
            const imgViewer = document.getElementById('image-viewer') as HTMLImageElement;

            title.textContent = `Papeleta de Infracción N° ${nroPapeleta}`;
            modal.classList.remove('hidden');
            loading.classList.remove('hidden');
            error.classList.add('hidden');
            pdfViewer.classList.add('hidden');
            imgViewer.classList.add('hidden');
            pdfViewer.src = "";
            imgViewer.src = "";

            try {
                const secKey = (import.meta.env.PUBLIC_CLIENT_SECRET || 'VehicularPESecretSecure2026');
                const res = await fetch(`${BACKEND_URL}/callao/pdf/${nroPapeleta}`, {
                    headers: { 'X-Client-Secret': secKey }
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const result = await res.json();
                if (result.success && result.data) {
                    loading.classList.add('hidden');
                    const base64Data = result.data.trim();
                    if (base64Data.startsWith('JVBER')) {
                        pdfViewer.src = `data:application/pdf;base64,${base64Data}`;
                        pdfViewer.classList.remove('hidden');
                    } else if (base64Data.startsWith('/9j/') || base64Data.startsWith('iVBOR')) {
                        const mime = base64Data.startsWith('iVBOR') ? 'image/png' : 'image/jpeg';
                        imgViewer.src = `data:${mime};base64,${base64Data}`;
                        imgViewer.classList.remove('hidden');
                    } else {
                        if (nroPapeleta.endsWith('A') || nroPapeleta.endsWith('B')) {
                            imgViewer.src = `data:image/jpeg;base64,${base64Data}`;
                            imgViewer.classList.remove('hidden');
                        } else {
                            pdfViewer.src = `data:application/pdf;base64,${base64Data}`;
                            pdfViewer.classList.remove('hidden');
                        }
                    }
                } else {
                    throw new Error(result.error || 'No se obtuvieron datos de la papeleta');
                }
            } catch (err: any) {
                loading.classList.add('hidden');
                error.classList.remove('hidden');
                errorMsg.textContent = err.message || 'Error de conexión con el servidor.';
            }
        };

        (window as any).abrirModalImagen = function(imgSrc: string, titleText: string = 'Foto Probatoria') {
            const modal = document.getElementById('papeleta-modal')!;
            const title = document.getElementById('modal-papeleta-title')!;
            const loading = document.getElementById('modal-loading')!;
            const error = document.getElementById('modal-error')!;
            const pdfViewer = document.getElementById('pdf-viewer') as HTMLIFrameElement;
            const imgViewer = document.getElementById('image-viewer') as HTMLImageElement;

            title.textContent = titleText;
            modal.classList.remove('hidden');
            loading.classList.add('hidden');
            error.classList.add('hidden');
            pdfViewer.classList.add('hidden');
            
            imgViewer.src = imgSrc;
            imgViewer.classList.remove('hidden');
        };

        (window as any).abrirModalFotoCinemometro = async function(nroPapeleta: string, fotoTarget: string, plate: string) {
            const modal = document.getElementById('papeleta-modal')!;
            const title = document.getElementById('modal-papeleta-title')!;
            const loading = document.getElementById('modal-loading')!;
            const error = document.getElementById('modal-error')!;
            const errorMsg = document.getElementById('modal-error-msg')!;
            const pdfViewer = document.getElementById('pdf-viewer') as HTMLIFrameElement;
            const imgViewer = document.getElementById('image-viewer') as HTMLImageElement;

            title.textContent = `Foto Probatoria - Papeleta N° ${nroPapeleta}`;
            modal.classList.remove('hidden');
            error.classList.add('hidden');
            pdfViewer.classList.add('hidden');
            imgViewer.classList.add('hidden');
            pdfViewer.src = "";
            imgViewer.src = "";

            const fotoDirect = (window as any).cinemometroFotos?.[nroPapeleta];
            if (fotoDirect && (fotoDirect.startsWith('data:') || fotoDirect.startsWith('http'))) {
                loading.classList.add('hidden');
                imgViewer.src = fotoDirect;
                imgViewer.classList.remove('hidden');
                return;
            }

            loading.classList.remove('hidden');

            try {
                const secKey = (import.meta.env.PUBLIC_CLIENT_SECRET || 'VehicularPESecretSecure2026');
                const url = `${BACKEND_URL}/cinemometro/foto/${plate}?target=${encodeURIComponent(fotoTarget)}`;
                const res = await fetch(url, {
                    headers: { 'X-Client-Secret': secKey }
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const result = await res.json();
                loading.classList.add('hidden');

                if (result.success && result.foto) {
                    imgViewer.src = result.foto;
                    imgViewer.classList.remove('hidden');
                } else {
                    throw new Error(result.error || 'No se pudo obtener la foto probatoria de SUTRAN');
                }
            } catch (err: any) {
                loading.classList.add('hidden');
                error.classList.remove('hidden');
                errorMsg.textContent = err.message || 'Error al conectar con SUTRAN para obtener la foto.';
            }
        };

        (window as any).cerrarModalPapeleta = function() {
            const modal = document.getElementById('papeleta-modal')!;
            modal.classList.add('hidden');
            const pdfViewer = document.getElementById('pdf-viewer') as HTMLIFrameElement;
            const imgViewer = document.getElementById('image-viewer') as HTMLImageElement;
            pdfViewer.src = "";
            imgViewer.src = "";
        };
</script>
    <!-- Modal para ver PDF/Imagen de Papeleta -->
    <div id="papeleta-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-slate-200 dark:border-white/10">
            <!-- Header -->
            <div class="px-5 py-4 border-b border-slate-200 dark:border-white/10 flex justify-between items-center bg-slate-50 dark:bg-slate-800/50">
                <h3 id="modal-papeleta-title" class="font-bold text-slate-800 dark:text-white text-base font-inter">Papeleta de Infracción</h3>
                <button onclick="window.cerrarModalPapeleta()" class="text-slate-400 hover:text-slate-655 dark:hover:text-white transition-all text-xl p-1">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <!-- Body -->
            <div class="flex-1 overflow-auto p-5 min-h-[400px] flex items-center justify-center bg-slate-100 dark:bg-slate-900/30">
                <div id="modal-loading" class="hidden flex flex-col items-center gap-3">
                    <div class="w-10 h-10 rounded-full border-4 border-brand-yellow/20 border-t-brand-yellow animate-spin"></div>
                    <p class="text-xs text-slate-500 font-inter">Cargando documento desde el portal...</p>
                </div>
                <div id="modal-error" class="hidden text-center max-w-sm">
                    <i class="fas fa-exclamation-circle text-3xl text-red-500 mb-2 block"></i>
                    <p class="text-sm font-bold text-red-700 dark:text-red-400 font-inter">No se pudo cargar el documento</p>
                    <p id="modal-error-msg" class="text-xs text-slate-500 mt-1 font-inter"></p>
                </div>
                <iframe id="pdf-viewer" class="hidden w-full h-[65vh] border-0 rounded-lg shadow-sm" src=""></iframe>
                <img id="image-viewer" class="hidden max-w-full max-h-[65vh] object-contain rounded-lg shadow-sm" alt="Papeleta" />
            </div>
        </div>
    </div>

    {/* Modal de Mantenimiento Temporal */}
    <MaintenanceModal />
</body>


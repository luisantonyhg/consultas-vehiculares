                    <script>
        // ====================================================
        // CONFIG
        // ====================================================
        const BACKEND_URL = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:8000/api/v1';

        // ====================================================
        // CAPTCHA DE SEGURIDAD
        // ====================================================
        let currentCaptchaCode = '';

        function generateCaptchaCode() {
            const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ'; // Evitamos caracteres confusos como 0, 1, O, I
            let code = '';
            for (let i = 0; i < 4; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return code;
        }

        function drawCaptcha() {
            const canvas = document.getElementById('captcha-canvas') as HTMLCanvasElement;
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            currentCaptchaCode = generateCaptchaCode();

            // Fondo adaptado al tema actual
            ctx.fillStyle = document.documentElement.classList.contains('dark') ? '#1e293b' : '#f8fafc';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Líneas de ruido de fondo
            ctx.strokeStyle = document.documentElement.classList.contains('dark') ? 'rgba(255, 255, 255, 0.15)' : 'rgba(0, 0, 0, 0.15)';
            for (let i = 0; i < 4; i++) {
                ctx.beginPath();
                ctx.moveTo(Math.random() * canvas.width, Math.random() * canvas.height);
                ctx.lineTo(Math.random() * canvas.width, Math.random() * canvas.height);
                ctx.stroke();
            }

            // Puntos de ruido
            ctx.fillStyle = document.documentElement.classList.contains('dark') ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
            for (let i = 0; i < 15; i++) {
                ctx.beginPath();
                ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 3, 0, Math.PI * 2);
                ctx.fill();
            }

            // Caracteres distorsionados y de colores premium
            const colors = ['#f59e0b', '#fbbf24', '#f59e0b', '#fbbf24', '#e2e8f0', '#38bdf8', '#f43f5e', '#34d399'];
            ctx.font = 'bold 18px "Archivo Black", sans-serif';
            ctx.textBaseline = 'middle';

            for (let i = 0; i < currentCaptchaCode.length; i++) {
                const char = currentCaptchaCode[i];
                ctx.fillStyle = colors[Math.floor(Math.random() * colors.length)];
                
                ctx.save();
                const x = 12 + i * 22 + Math.random() * 5;
                const y = canvas.height / 2 + (Math.random() * 6 - 3);
                const angle = (Math.random() * 30 - 15) * Math.PI / 180;
                
                ctx.translate(x, y);
                ctx.rotate(angle);
                ctx.fillText(char, 0, 0);
                ctx.restore();
            }
        }

        // Registrar inicialización de captcha al cargar DOM
        window.addEventListener('DOMContentLoaded', () => {
            drawCaptcha();

            const canvas = document.getElementById('captcha-canvas');
            const refreshBtn = document.getElementById('refresh-captcha-btn');
            const themeBtn = document.getElementById('theme-toggle');

            if (canvas) canvas.addEventListener('click', drawCaptcha);
            if (refreshBtn) refreshBtn.addEventListener('click', drawCaptcha);
            if (themeBtn) themeBtn.addEventListener('click', () => setTimeout(drawCaptcha, 120));
        });

        // ====================================================
        // TEMA
        // ====================================================
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-toggle-icon');

        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                if (themeIcon) themeIcon.className = 'fas fa-sun text-brand-yellow text-lg transition-transform duration-500 hover:rotate-45';
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                if (themeIcon) themeIcon.className = 'fas fa-moon text-slate-700 text-lg transition-transform duration-500 hover:rotate-12';
            }
        }

        const savedTheme = localStorage.getItem('theme') || 'light';
        applyTheme(savedTheme);
        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                applyTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark');
            });
        }

        // ====================================================
        // FORMATO DE PLACA
        // ====================================================
        const plateInput = document.getElementById('plate-search-input') as HTMLInputElement;
        if (plateInput) {
            plateInput.addEventListener('input', () => {
                let val = plateInput.value.replace(/[^A-Za-z0-9-]/g, '').toUpperCase();
                const cleanVal = val.replace(/-/g, '');
                if (cleanVal.length === 6 && !val.includes('-')) {
                    val = cleanVal.slice(0, 3) + '-' + cleanVal.slice(3);
                }
                plateInput.value = val;
            });
        }

        // ====================================================
        // VERIFICAR BACKEND AL CARGAR
        // ====================================================
        async function checkBackend() {
            const healthUrl = BACKEND_URL.replace('/api/v1', '') + '/health';
            try {
                const res = await fetch(healthUrl, { signal: AbortSignal.timeout(5000) });
                if (!res.ok) throw new Error();
                document.getElementById('backend-status-banner')?.classList.add('hidden');
            } catch {
                const bannerText = document.querySelector('#backend-status-banner p');
                if (bannerText) {
                    const displayUrl = healthUrl.replace('/health', '');
                    bannerText.innerHTML = `<i class="fas fa-exclamation-triangle mr-1"></i> Backend no disponible en este momento. Asegúrate de que el servidor esté activo en <code class="bg-black/20 px-1 rounded">${displayUrl}</code>`;
                }
                document.getElementById('backend-status-banner')?.classList.remove('hidden');
            }
        }
        checkBackend();

        // ====================================================
        // VEHICLE DATA ACCUMULATION
        // ====================================================
        let vehicleData: Record<string, string> = {};

        function processVehicleInfo(cardId: string, data: any) {
            if (!data) return;
            let updated = false;

            if (cardId === 'soat' && Array.isArray(data) && data.length > 0) {
                const cert = data[0];
                if (cert.Marca && !vehicleData.marca) { vehicleData.marca = cert.Marca; updated = true; }
                if (cert.ModeloVehiculo && !vehicleData.modelo) { vehicleData.modelo = cert.ModeloVehiculo; updated = true; }
                if (cert.NombreClaseVehiculo && !vehicleData.categoria) { vehicleData.categoria = cert.NombreClaseVehiculo; updated = true; }
                if (cert.NombreUsoVehiculo && !vehicleData.uso) { vehicleData.uso = cert.NombreUsoVehiculo; updated = true; }
            }

            if (cardId === 'citv' && Array.isArray(data) && data.length > 0) {
                const cert = data[0];
                if (cert.marca && !vehicleData.marca) { vehicleData.marca = cert.marca; updated = true; }
                if (cert.modelo && !vehicleData.modelo) { vehicleData.modelo = cert.modelo; updated = true; }
                if (cert.clase && !vehicleData.categoria) { vehicleData.categoria = cert.clase; updated = true; }
                if (cert.anio && !vehicleData.anio) { vehicleData.anio = cert.anio; updated = true; }
            }

            if (cardId === 'atu' && data) {
                if (data.fuenteDato !== 'NOREGISTRADO') {
                    if (data.marcaSunarp && !vehicleData.marca) { vehicleData.marca = data.marcaSunarp; updated = true; }
                    if (data.modeloSunarp && !vehicleData.modelo) { vehicleData.modelo = data.modeloSunarp; updated = true; }
                    if (data.color && !vehicleData.color) { vehicleData.color = data.color; updated = true; }
                    if (data.serie && !vehicleData.serie) { vehicleData.serie = data.serie; updated = true; }
                    if (data.motor && !vehicleData.motor) { vehicleData.motor = data.motor; updated = true; }
                    if (data.propietario && !vehicleData.propietario) { vehicleData.propietario = data.propietario; updated = true; }
                } else {
                    if (data.marcaSunarp && !vehicleData.marca) { vehicleData.marca = data.marcaSunarp; updated = true; }
                    if (data.modeloSunarp && !vehicleData.modelo) { vehicleData.modelo = data.modeloSunarp; updated = true; }
                    if (data.color && !vehicleData.color) { vehicleData.color = data.color; updated = true; }
                    if (data.serie && !vehicleData.serie) { vehicleData.serie = data.serie; updated = true; }
                    if (data.motor && !vehicleData.motor) { vehicleData.motor = data.motor; updated = true; }
                }
            }

            if (updated) {
                renderVehicleInfoCard();
            }
        }


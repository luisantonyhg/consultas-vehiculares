        (window as any).compartirWhatsApp = async function(plate: string) {
            const texto = `🚗 Reporte vehicular de la placa ${plate} · Consulta gratis la tuya en ${window.location.origin}`;
            const btnSel = "button[onclick=\"window.compartirWhatsApp('" + plate + "')\"]";
            const btn = document.querySelector(btnSel) as HTMLButtonElement | null;
            const originalHTML = btn ? btn.innerHTML : '';
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando...'; }

            // Modal con la tarjeta REAL visible (en pantalla) → se captura correctamente.
            document.getElementById('share-modal')?.remove();
            const overlay = document.createElement('div');
            overlay.id = 'share-modal';
            overlay.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(2,6,23,0.85);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:18px;overflow:auto;';
            const wrap = document.createElement('div');
            wrap.style.cssText = 'width:100%;max-width:400px;display:flex;flex-direction:column;gap:14px;';
            const card = construirTarjetaImagen(plate);
            const controls = document.createElement('div');
            controls.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:13px;font-weight:700;font-family:Poppins,sans-serif;padding:6px;"><i class="fas fa-spinner fa-spin"></i> Preparando imagen...</div>';
            wrap.appendChild(card);
            wrap.appendChild(controls);
            overlay.appendChild(wrap);
            document.body.appendChild(overlay);
            const close = () => overlay.remove();
            overlay.addEventListener('click', (ev) => { if (ev.target === overlay) close(); });

            let file: File | null = null;
            let dataUrl = '';
            try {
                await new Promise(r => setTimeout(r, 90)); // dejar pintar la tarjeta
                // backgroundColor evita transparencia→negro; skipFonts evita CSS remoto.
                dataUrl = await toPng(card, { pixelRatio: 2, cacheBust: true, skipFonts: true, backgroundColor: '#0b1220' });
                const blob = await (await fetch(dataUrl)).blob();
                file = new File([blob], `reporte-${plate}.png`, { type: 'image/png' });
            } catch (e) {
                console.error('[SHARE] Error generando imagen:', e);
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
            }

            // Botones (el share se dispara con gesto FRESCO desde este click → sin await previo).
            controls.innerHTML = `
                <div style="display:flex;gap:10px;">
                    <button id="sm-share" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;border:0;border-radius:14px;background:#22c55e;color:#fff;font-weight:800;font-size:15px;cursor:pointer;font-family:Poppins,sans-serif;">
                        <i class="fab fa-whatsapp"></i> Compartir
                    </button>
                    <button id="sm-dl" title="Descargar" style="width:54px;display:flex;align-items:center;justify-content:center;padding:14px;border:0;border-radius:14px;background:#334155;color:#fff;font-size:16px;cursor:pointer;">
                        <i class="fas fa-download"></i>
                    </button>
                </div>
                <button id="sm-close" style="margin-top:10px;width:100%;padding:10px;border:0;border-radius:12px;background:transparent;color:#94a3b8;font-weight:700;font-size:13px;cursor:pointer;font-family:Poppins,sans-serif;">Cerrar</button>`;
            (document.getElementById('sm-close') as HTMLElement).onclick = close;
            (document.getElementById('sm-dl') as HTMLElement).onclick = () => {
                if (!dataUrl) return;
                const a = document.createElement('a'); a.href = dataUrl; a.download = `reporte-${plate}.png`; a.click();
            };
            (document.getElementById('sm-share') as HTMLElement).onclick = () => {
                const nav = navigator as any;
                if (file && nav.canShare && nav.canShare({ files: [file] })) {
                    nav.share({ files: [file], title: `Reporte ${plate}`, text: texto }).then(close).catch(() => {});
                } else {
                    if (dataUrl) { const a = document.createElement('a'); a.href = dataUrl; a.download = `reporte-${plate}.png`; a.click(); }
                    window.open('https://wa.me/?text=' + encodeURIComponent(texto), '_blank');
                }
            };
        };


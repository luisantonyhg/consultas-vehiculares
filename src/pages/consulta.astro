        function cardHeaderAccordion(cardId: string, title: string, sourceName: string, iconClass: string, badgeHTML: string, isExpanded: boolean) {
            const c = getColors(cardId);
            const activeHeaderClass = isExpanded 
                ? "bg-gradient-to-r from-[#1a3a6b] to-[#0b1c36] text-white border-b-2 border-slate-900 dark:border-slate-800" 
                : "bg-white dark:bg-slate-900 text-slate-900 dark:text-white";
            const iconBg = isExpanded
                ? "bg-white/10 ring-1 ring-white/20 text-white"
                : `${c.bg} ring-2 ${c.ring} ${c.icon}`;
            const textClass = isExpanded ? "text-white font-bold" : "text-slate-900 dark:text-white font-bold";
            const subtextClass = isExpanded ? "text-white/60 font-semibold" : "text-slate-400 dark:text-slate-500 font-semibold";
            const chevronClass = isExpanded ? "rotate-180 text-white" : "text-slate-400 dark:text-slate-500";
            
            const logoSrc = LOGO_MAPPING[cardId] || '';

                        </div>
                    </div>
                    <div style="text-align:right;">
                        <div style="color:#64748b;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Placa</div>
                        <div style="color:#fff;font-size:20px;font-weight:900;letter-spacing:2px;font-family:'Courier New',monospace;">${plate}</div>

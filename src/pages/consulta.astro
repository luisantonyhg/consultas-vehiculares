---
// Vista de consulta específica por placa - Integrada con el Backend real
import MaintenanceModal from '../components/MaintenanceModal.astro';
---

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Cañita | Consulta Vehicular por Placa en Tiempo Real (SUNARP, SOAT, SUTRAN)</title>
    <meta name="description" content="Cañita: Consulta integral de placas vehiculares en tiempo real en Perú. Información oficial de SUNARP, SOAT, CITV, SUTRAN, SAT, ATU y Lunas Polarizadas.">
    <meta name="keywords" content="Cañita, Canita, Consulta vehicular Cañita, Consulta por Placa, SUNARP, SOAT, CITV, SAT, SUTRAN, ATU, Lunas PNP, Perú">
    <meta name="author" content="Luis Antony Huamani Gonzales">
    <meta name="designer" content="Luis Antony Huamani Gonzales">
    <meta name="robots" content="index, follow">

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website">
    <meta property="og:title" content="Cañita | Consulta Vehicular por Placa en Tiempo Real">
    <meta property="og:description" content="Cañita: Consulta rápida de placas vehiculares en tiempo real en Perú con información de SUNARP, SOAT, CITV, SAT, SUTRAN y más.">
    <meta property="og:image" content="/assets/logocanita.jpeg">
    
    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="Cañita | Consulta Vehicular por Placa en Tiempo Real">
    <meta property="twitter:description" content="Cañita: Consulta vehicular por placa en tiempo real con datos de SUNARP, SOAT, SUTRAN, CITV y multas.">
    <meta property="twitter:image" content="/assets/logocanita.jpeg">

    {/* Structured Data (JSON-LD) */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://consultas-vehiculares.pages.dev/#person",
            "name": "Luis Antony Huamani Gonzales",
            "alternateName": "Huamani Gonzales Luis Antony",
            "jobTitle": "Ingeniero de Sistemas",
            "description": "Ingeniero de Sistemas y Desarrollador de Software especializado en desarrollo web premium y consumo de servicios públicos descentralizados.",
            "knowsAbout": ["Ingeniería de Sistemas", "Desarrollo Web", "Astro", "TypeScript", "Node.js", "Python", "Bases de Datos", "APIs"],
            "sameAs": [
              "https://github.com/luisantonyhg"
            ]
          },
          {
            "@type": "SoftwareApplication",
            "name": "Módulo de Consulta Vehicular por Placa",
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Web",
            "description": "Servicio de consulta de placas vehiculares integrado en tiempo real con captcha de seguridad.",
            "creator": {
              "@type": "Person",
              "name": "Luis Antony Huamani Gonzales"
            }
          }
        ]
      }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Dancing+Script:wght@700&family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ===== Reporte imprimible / PDF con Marca de Agua ===== */
        @media print {
            @page { margin: 8mm 8mm; size: A4; }
            body { 
                background: #fff !important; 
                position: relative !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                font-size: 11px !important;
            }
            /* Marca de agua diagonal múltiple y repetitiva de CAÑITA */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                width: 100%;
                height: 100%;
                background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='170' viewBox='0 0 260 170'><text x='50%' y='50%' fill='%2364748b' fill-opacity='0.07' font-size='24' font-weight='900' font-family='sans-serif' text-anchor='middle' transform='rotate(-28 130 85)'>CAÑITA</text></svg>");
                background-repeat: repeat;
                pointer-events: none;
                z-index: 9999;
            }
            /* Ocultar elementos de navegación y formularios */
            header, footer, nav, .no-print,
            #query-form, #hero-section, #captcha-container { display: none !important; }
            /* Forzar tarjetas compactas, nítidas y expandidas sin espacios en blanco */
            .results-card, .accordion-card {
                break-inside: avoid; page-break-inside: avoid;
                box-shadow: none !important; border: 1px solid #cbd5e1 !important;
                background: #fff !important; color: #0f172a !important;
                border-radius: 8px !important; margin-bottom: 8px !important;
                padding: 10px !important;
            }
            table, tr, td, th {
                padding: 3px 6px !important;
                font-size: 10.5px !important;
            }
            .accordion-body { display: block !important; }
            #results-section { margin-top: 0 !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; }
            .print-only { display: block !important; }
        }
        .print-only { display: none; }
        @keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes shimmer {
            0%   { background-position: -600px 0; }
            100% { background-position: 600px 0; }
        }
        @keyframes pulseRing {
            0%   { box-shadow: 0 0 0 0 rgba(234,179,8,0.35); }
            70%  { box-shadow: 0 0 0 10px rgba(234,179,8,0); }
            100% { box-shadow: 0 0 0 0 rgba(234,179,8,0); }
        }
        .card-animate { animation: fadeSlideIn 0.4s ease both; }
        .skeleton {
            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
            background-size: 600px 100%;
            animation: shimmer 1.5s infinite linear;
            border-radius: 6px;
        }
        .dark .skeleton {
            background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
            background-size: 600px 100%;
            animation: shimmer 1.5s infinite linear;
        }
        .spin-icon { animation: spin 1.2s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .results-card { transition: box-shadow 0.25s ease, transform 0.2s ease; }
        .results-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.12); transform: translateY(-2px); }
        .accordion-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .accordion-card:hover {
            box-shadow: 0 8px 24px rgba(26, 58, 107, 0.12);
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800 transition-colors duration-300 min-h-screen font-poppins flex flex-col pb-10">

    <main class="w-full flex-1 flex flex-col items-center">
        {/* Banner Section */}
        <section class="w-full bg-[radial-gradient(circle,_#1a3a6b_0%,_#0b1c36_100%)] border-b border-white/5 px-5 py-4 md:py-4 md:px-2 flex flex-col items-center overflow-hidden relative">
            
            {/* Header / Barra de Navegación con Logo Rectangular Cañita */}
            <header class="w-full max-w-[1100px] flex justify-between items-center py-2 mx-auto px-4 md:px-2.5 z-20 gap-3">
                <a href="/" class="flex items-center gap-2.5 group shrink-0">
                    <div class="w-28 h-10 sm:w-32 sm:h-12 rounded-xl bg-white overflow-hidden shadow-md border-2 border-brand-yellow/85 flex items-center justify-center p-0.5 transition-transform group-hover:scale-105">
                        <img 
                            src="/assets/logocanita.jpeg" 
                            alt="Logo Cañita" 
                            class="w-full h-full object-contain rounded-lg" 
                        />
                    </div>
                    <div class="hidden xs:flex flex-col text-left">
                        <span class="text-white font-archivo text-base md:text-xl font-black tracking-tight leading-none group-hover:text-brand-yellow transition-colors">CAÑITA</span>
                        <span class="text-brand-yellow text-[8.5px] md:text-[10px] font-extrabold tracking-widest uppercase">Consultas Vehiculares</span>
                    </div>
                </a>
                <a
                    href="/"
                    class="w-10 h-10 sm:w-auto sm:px-4 sm:py-2.5 rounded-xl bg-white/10 text-white hover:bg-white/20 transition-all duration-300 flex items-center justify-center gap-2 text-xs md:text-sm font-semibold shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-yellow/50 active:scale-95 shrink-0"
                    title="Volver al Dashboard"
                >
                    <i class="fas fa-arrow-left text-sm"></i>
                    <span class="hidden sm:inline">Volver al Dashboard</span>
                </a>
            </header>

            <div class="max-w-[1100px] w-full flex flex-row flex-nowrap justify-between items-center gap-1 md:gap-5 px-0 md:px-2.5 mt-2 relative">
                
                <img
                    src="/assets/fortuner.png"
                    alt="Toyota Fortuner"
                    class="car-img absolute left-1 top-[12px] md:relative md:left-auto md:top-auto order-1 w-[55px] sm:w-[80px] md:w-auto md:max-w-[280px] h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] z-10 -ml-1 md:-ml-5 transition-transform duration-500 hover:scale-105 shrink-0"
                />

                {/* Contenido Central */}
                <div class="banner-content order-2 text-center flex-1 z-10 w-full md:w-auto -mt-2 md:mt-0 px-2">
                    <h1 class="text-brand-yellow font-archivo text-[36px] md:text-[55px] italic leading-[0.9] m-0 tracking-[-1.5px] md:tracking-[-2px] drop-shadow-[2px_2px_0px_rgba(0,0,0,0.5)] uppercase">
                        CONSULTA
                    </h1>
                    <div class="text-brand-yellow font-dancing text-[26px] md:text-[38px] -my-[3px] flex justify-center items-center gap-2">
                        <span>de tu</span>
                        <span class="text-white">Vehículo</span>
                        <span class="text-white/80 font-normal font-sans text-lg md:text-2xl">por</span>
                        <span>Placa</span>
                    </div>
                    
                    <p class="text-white/95 text-xs md:text-sm mt-3.5 font-medium tracking-wide">
                        Ingresa el número de placa para realizar un análisis vehicular integral en tiempo real
                    </p>

                    {/* Módulo de Búsqueda */}
                    <form id="query-form" class="mt-5 max-w-[340px] mx-auto bg-white/10 border border-white/20 p-4 rounded-2xl flex flex-col gap-4 shadow-lg focus-within:ring-2 focus-within:ring-brand-yellow/50 transition-all duration-300">
                        {/* Input de Placa - Fila Superior */}
                        <div class="w-full pb-3 border-b border-white/10">
                            <input
                                type="text"
                                id="plate-search-input"
                                placeholder="ABC-123"
                                maxlength="9"
                                class="w-full bg-white/5 border border-white/25 rounded-xl font-archivo text-xl text-white font-bold placeholder-white/30 uppercase text-center py-2.5 focus:ring-1 focus:ring-brand-yellow focus:border-brand-yellow focus:outline-none"
                                required
                                aria-label="Ingresa tu placa vehicular para consultar"
                            />
                        </div>

                        {/* Captcha de Seguridad - Fila del Medio */}
                        <div id="captcha-row" class="flex items-center justify-between gap-2 pb-3 border-b border-white/10">
                            <div class="flex items-center gap-2 shrink-0">
                                <canvas id="captcha-canvas" class="rounded bg-white/10 cursor-pointer border border-white/10 select-none shadow-sm" width="150" height="45" title="Clic para recargar captcha"></canvas>
                                <button
                                    type="button"
                                    id="refresh-captcha-btn"
                                    class="text-white/40 hover:text-white transition-all text-xs p-1 focus:outline-none"
                                    title="Recargar Captcha"
                                >
                                    <i class="fas fa-rotate-right"></i>
                                </button>
                            </div>
                            <input
                                type="text"
                                id="captcha-input"
                                placeholder="Poner código captcha"
                                maxlength="4"
                                class="w-[130px] flex-1 min-w-0 text-center rounded-lg border border-white/20 bg-white/5 text-white text-xs font-bold uppercase py-1.5 px-2 focus:ring-1 focus:ring-brand-yellow focus:outline-none placeholder-white/30 placeholder:normal-case"
                                required
                                autocomplete="off"
                            />
                        </div>

                        {/* Botón de Buscar - Fila Inferior */}
                        <div class="w-full">
                            <button
                                type="submit"
                                id="submit-btn"
                                class="w-full bg-brand-yellow hover:bg-[#ffd000]/80 text-brand-navy-dark py-3 rounded-xl transition-all duration-300 font-extrabold flex items-center justify-center gap-2 active:scale-[0.98] whitespace-nowrap text-sm shadow-md"
                            >
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </form>
                    
                    <p
                        id="query-status"
                        class="text-xs text-brand-yellow mt-2 font-medium opacity-0 transition-opacity duration-300 pointer-events-none"
                    >
                        &nbsp;
                    </p>

                    <p class="text-white font-archivo text-[10px] md:text-xs italic tracking-widest uppercase mt-4">Realizado por:</p>
                    <p class="text-brand-yellow font-dancing text-[24px] md:text-[32px] -mt-1 drop-shadow-[1px_1px_0px_rgba(0,0,0,0.5)]">Huamani Gonzales Luis Antony</p>
                    <p class="text-white/95 font-archivo text-[10px] md:text-xs tracking-wider uppercase -mt-1.5 mb-1.5 opacity-90">Egresado de la carrera de Ingeniería de Sistemas</p>
                    <div class="mt-4 pt-3 border-t border-white/15 max-w-[500px] mx-auto text-center font-sans">
                        <p class="text-white/95 text-xs md:text-sm leading-relaxed">
                            Si tienes una <strong>idea de negocio</strong> o un <strong>proyecto tecnológico</strong> en mente, ¡puedes contactarme!
                        </p>
                        <div class="mt-3 flex flex-wrap items-center justify-center gap-2.5">
                            <a 
                                href="https://www.instagram.com/luisantonyhg/" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-purple-600 via-pink-600 to-yellow-500 hover:from-purple-500 hover:to-yellow-400 text-white font-extrabold text-[11px] md:text-xs transition-all duration-300 shadow-md transform hover:-translate-y-0.5 active:scale-95"
                            >
                                <i class="fab fa-instagram text-sm md:text-base"></i>
                                <span>@luisantonyhg</span>
                            </a>
                            <span class="text-[10px] md:text-xs text-brand-yellow font-extrabold">¡Sígueme y te asesoro gratis! 💡</span>
                        </div>
                    </div>
                </div>

                <img
                    src="/assets/hilux.png"
                    alt="Toyota Hilux"
                    class="car-img absolute right-1 top-[12px] md:relative md:right-auto md:top-auto order-3 w-[55px] sm:w-[80px] md:w-auto md:max-w-[280px] h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] z-10 -mr-1 md:-mr-5 transition-transform duration-500 hover:scale-105 shrink-0"
                />
            </div>
        </section>

        {/* Sección de Resultados con Recordatorio de Marca Cañita */}
        <div id="results-section" class="w-full max-w-[1100px] mt-8 px-5 md:px-[15px] z-10">
            <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-6 gap-2">
                <div class="flex items-center gap-3 text-slate-800">
                    <i class="fas fa-chart-line text-brand-red text-xl"></i>
                    <h2 class="text-base sm:text-xl font-bold tracking-wide font-poppins">Resultados del Análisis</h2>
                </div>
                <div class="flex items-center gap-1.5 shrink-0 select-none">
                    <div class="w-6 h-6 rounded-md bg-white border border-slate-200 shadow-xs flex items-center justify-center p-0.5">
                        <img src="/assets/logocanita.jpeg" class="w-full h-full object-contain rounded" alt="Logo Cañita" />
                    </div>
                    <span class="text-slate-850 dark:text-slate-200 font-archivo text-[11px] md:text-xs font-black tracking-tight">CAÑITA</span>
                </div>
            </div>
            
            {/* Estado inicial */}
            <div
                id="results-container"
                class="w-full max-w-xl mx-auto text-center py-12 px-6 rounded-2xl border border-dashed border-slate-200 bg-white shadow-md text-slate-900 font-poppins"
            >
                <i class="fas fa-folder-open text-4xl text-slate-300 mb-3.5 block"></i>
                <p class="font-extrabold text-slate-755 text-lg">Esperando Datos</p>
                <p class="text-xs text-slate-500 mt-1 max-w-[300px] mx-auto leading-relaxed">
                    Ingresa una placa arriba para realizar un análisis vehicular integral en tiempo real.
                </p>
            </div>
        </div>

    </main>

    {/* Footer */}
    <footer class="mt-16 py-10 px-5 bg-slate-100 backdrop-blur-md border-t border-slate-200 text-center w-full">
        <div class="max-w-[1100px] mx-auto">
            <p class="text-xs text-slate-400 mb-1.5 uppercase tracking-widest">Realizado por:</p>
            <p class="text-lg md:text-xl font-extrabold text-slate-800 mb-1">Luis Antony Huamani Gonzales</p>
            <p class="text-xs text-slate-500 -mt-0.5 mb-3 font-semibold uppercase tracking-wide">Egresado de la carrera de Ingeniería de Sistemas</p>

            {/* Contador de Visitas */}
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900 text-white border border-slate-700/60 text-xs font-semibold mb-6 shadow-md transition-all hover:scale-105">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <i class="fas fa-users text-amber-400"></i>
                <span>Personas que han ingresado: <strong id="visit-counter" class="font-extrabold text-emerald-400 tracking-wide font-mono">...</strong></span>
            </div>

            {/* Aviso Legal y Uso Ético */}
            <div class="mt-8 pt-8 border-t border-slate-200 text-left max-w-3xl mx-auto">
                <div class="bg-white/50 border border-slate-200/60 p-4 md:p-6 rounded-2xl shadow-sm font-poppins">
                    <h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-widest flex items-center gap-2 mb-3 font-inter">
                        <i class="fas fa-shield-halved text-brand-red"></i>
                        Aviso Legal y Uso Ético de la Información
                    </h4>
                    <p class="text-[11px] md:text-xs text-slate-500 mb-5 leading-relaxed">
                        Este portal web es una herramienta de consulta descentralizada e independiente. Facilita la unificación de información pública de libre acceso a través de técnicas avanzadas de automatización y lectura de datos abiertos, sin emplear servicios web oficiales ni APIs provistas por el estado. Al utilizar esta herramienta, usted acepta cumplir con las siguientes directrices:
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-[10px] md:text-[11px] leading-relaxed">
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-150">
                            <p class="font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                <i class="fas fa-database text-blue-500"></i> Cero Almacenamiento
                            </p>
                            <p class="text-slate-500">
                                Luis Antony Huamani Gonzales NO recopila, almacena ni comparte datos de placas o búsquedas. Las consultas operan en tiempo real como intermediario directo.
                            </p>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-150">
                            <p class="font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                <i class="fas fa-gavel text-amber-500"></i> Uso Legítimo
                            </p>
                            <p class="text-slate-500">
                                Prohibido el uso de este portal para actividades de acoso, extorsión o fraude. El portal implementa captchas para evitar abusos automatizados.
                            </p>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-150">
                            <p class="font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                <i class="fas fa-globe text-emerald-500"></i> Responsabilidad
                            </p>
                            <p class="text-slate-500">
                                El usuario final asume plena responsabilidad legal y moral por las consultas realizadas y la interpretación de la información mostrada.
                            </p>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-150">
                            <p class="font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                <i class="fas fa-arrow-up-right-from-square text-cyan-500"></i> Verificación Oficial
                            </p>
                            <p class="text-slate-500">
                                Se proveen enlaces directos en el pie de cada sección para que el investigador pueda corroborar los resultados directamente con el portal del estado respectivo.
                            </p>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-150">
                            <p class="font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                <i class="fas fa-robot text-indigo-500"></i> Automatización Ética
                            </p>
                            <p class="text-slate-500">
                                Las consultas automatizan la navegación por portales web abiertos del gobierno de forma segura y optimizada, respetando los términos de acceso a datos públicos.
                            </p>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-150">
                            <p class="font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                <i class="fas fa-circle-info text-rose-500"></i> Límites de Servicio
                            </p>
                            <p class="text-slate-500">
                                La exactitud y disponibilidad temporal de los datos dependen enteramente del funcionamiento y estabilidad de los servidores externos de terceros.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Modal Oficial de Visualización de Copia de Papeleta SAT Lima -->
    <div id="sat-ticket-modal" class="fixed inset-0 z-[99999] hidden items-center justify-center p-3 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-all duration-300">
        <div class="relative w-full max-w-4xl bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden flex flex-col max-h-[90vh] font-poppins">
            <!-- Header del Modal -->
            <div class="flex items-center justify-between px-4 sm:px-6 py-3.5 bg-slate-900 text-white border-b border-slate-800">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-400">
                        <i class="fas fa-file-invoice text-sm"></i>
                    </div>
                    <div>
                        <h3 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-white">Copia Oficial de Papeleta SAT Lima</h3>
                        <p class="text-[10px] text-slate-400 font-mono" id="sat-modal-doc-title">Documento: —</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <a id="sat-modal-download-btn" href="#" download="Copia_Papeleta_SAT.jpg" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs uppercase tracking-wider transition-all shadow-xs active:scale-95">
                        <i class="fas fa-download text-xs"></i> <span class="hidden sm:inline">Descargar Copia</span>
                    </a>
                    <button type="button" id="sat-modal-close-btn" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all active:scale-95 cursor-pointer" title="Cerrar (Esc)">
                        <i class="fas fa-xmark text-base"></i>
                    </button>
                </div>
            </div>

            <!-- Contenido / Visualizador -->
            <div class="relative flex-1 overflow-auto p-3 sm:p-5 flex items-center justify-center bg-slate-100 dark:bg-slate-950 min-h-[350px]">
                <div id="sat-modal-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs z-10">
                    <i class="fas fa-circle-notch fa-spin text-2xl text-blue-600"></i>
                    <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Cargando copia oficial del SAT...</span>
                </div>
                <img id="sat-modal-img" src="" alt="Copia de papeleta SAT" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-md border border-slate-200 dark:border-slate-800 hidden" />
                <iframe id="sat-modal-frame" src="" class="w-full h-[65vh] rounded-lg border border-slate-200 dark:border-slate-800 hidden"></iframe>
            </div>

            <!-- Footer del Modal -->
            <div class="px-4 sm:px-6 py-2.5 bg-slate-50 dark:bg-slate-900/90 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
                <span class="flex items-center gap-1.5"><i class="fas fa-shield-halved text-emerald-500"></i> Documento verificado desde servidor oficial SAT</span>
                <button type="button" id="sat-modal-close-footer" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white font-extrabold uppercase tracking-wider text-[10px] cursor-pointer">
                    Volver a la Consulta
                </button>
            </div>
        </div>
    </div>

    <script>
        import {
            LOGO_MAPPING,
            SOURCE_URLS,
            SERVICE_COLORS,
            getFormattedTimestamp,
            parseDateDDMMYYYY,
            fila,
            estadoBadge,
            cardHeaderAccordion,
            skeletonBody,
            reorderCards,
            setCardLoading,
            setCardWaiting,
            setCardDevelopment,
            setCardMaintenance,
            setCardData,
            setCardError,
            renderSOAT,
            renderCITV,
            renderLunas,
            renderCallao,
            renderLima,
            renderSutran,
            renderAtu,
            renderGNV,
            renderSBS,
            renderSunarp,
            renderVehicleInfoCard,
            renderFise
        } from '../utils/renderers.js';

        import {
            runFetchSOAT,
            runFetchCITV,
            runFetchLunas,
            runFetchCallao,
            runFetchSutran,
            runFetchCinemometro,
            runFetchATU,
            runFetchGNV,
            runFetchSBS,
            runFetchSUNARP,
            runFetchSAT,
            runFetchSATCaptura,
            runFetchSATDeposito,
            runFetchSATDeuda,
            runFetchMunicipal,
            runFetchPlacasPE,
            runFetchValorVenal,
            fillValorVenalSoles,
            runFetchOsinergmin,
            runFetchLima,
            runFetchFISE,
            runFetchPNP,
            initHistorialDueñosCard
        } from '../services/api.js';

        // ====================================================
        // CONFIG
        // ====================================================
        // En local usa localhost; en producción (Vercel HTTPS) usa el hostname HTTPS del VPS.
        // Esto evita "mixed content" (una página HTTPS NO puede llamar a un backend HTTP).
        const BACKEND_URL = import.meta.env.PUBLIC_BACKEND_URL || (
            (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
                ? 'http://localhost:8000/api/v1'
                : 'https://backend-consultarvehiculos-production.up.railway.app/api/v1'
        );

        function animateCount(el, target) {
            let start = 0;
            const duration = 1200;
            const startTime = performance.now();
            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = Math.floor(easeOut * target);
                el.textContent = current.toLocaleString();
                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    el.textContent = target.toLocaleString();
                }
            }
            requestAnimationFrame(update);
        }

        async function initVisits() {
            const counterEl = document.getElementById('visit-counter');
            const clientSecret = import.meta.env.PUBLIC_CLIENT_SECRET || 'VehicularPESecretSecure2026';
            try {
                // Registrar visita atómica (POST)
                const postRes = await fetch(`${BACKEND_URL}/visits`, { 
                    method: 'POST',
                    headers: { 'X-Client-Secret': clientSecret }
                }).catch(() => null);

                if (postRes && postRes.ok) {
                    const data = await postRes.json();
                    if (data.success && typeof data.total === 'number' && counterEl) {
                        animateCount(counterEl, data.total);
                        return;
                    }
                }
                
                // Fallback lectura GET
                const res = await fetch(`${BACKEND_URL}/visits`, {
                    headers: { 'X-Client-Secret': clientSecret }
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && typeof data.total === 'number' && counterEl) {
                        animateCount(counterEl, data.total);
                    }
                }
            } catch (e) {
                console.error("Error al cargar contador de visitas:", e);
                if (counterEl) counterEl.textContent = "—";
            }
        }
        initVisits();

        // ====================================================
        // MODAL SAT LIMA - VISUALIZADOR DE COPIA DE PAPELETA
        // ====================================================
        const satModal = document.getElementById('sat-ticket-modal') as HTMLElement;
        const satModalImg = document.getElementById('sat-modal-img') as HTMLImageElement;
        const satModalFrame = document.getElementById('sat-modal-frame') as HTMLIFrameElement;
        const satModalLoader = document.getElementById('sat-modal-loader') as HTMLElement;
        const satModalDocTitle = document.getElementById('sat-modal-doc-title') as HTMLElement;
        const satModalDownloadBtn = document.getElementById('sat-modal-download-btn') as HTMLAnchorElement;
        const satModalCloseBtn = document.getElementById('sat-modal-close-btn');
        const satModalCloseFooter = document.getElementById('sat-modal-close-footer');

        function openSatTicketModal(url: string, docNumber: string) {
            if (!satModal) return;
            if (satModalDocTitle) satModalDocTitle.textContent = `N° Documento: ${docNumber || '—'}`;
            if (satModalLoader) satModalLoader.classList.remove('hidden');
            if (satModalImg) satModalImg.classList.add('hidden');
            if (satModalFrame) satModalFrame.classList.add('hidden');

            if (satModalDownloadBtn) {
                satModalDownloadBtn.href = url;
                satModalDownloadBtn.download = `Papeleta_SAT_${docNumber || 'oficial'}.jpg`;
            }

            const isDirectImg = url.match(/\.(jpeg|jpg|gif|png|webp)($|\?)/i);
            if (isDirectImg) {
                if (satModalImg) {
                    satModalImg.src = url;
                    satModalImg.onload = () => {
                        if (satModalLoader) satModalLoader.classList.add('hidden');
                        satModalImg.classList.remove('hidden');
                    };
                    satModalImg.onerror = () => {
                        if (satModalLoader) satModalLoader.classList.add('hidden');
                        if (satModalFrame) {
                            satModalFrame.src = url;
                            satModalFrame.classList.remove('hidden');
                        }
                    };
                }
            } else {
                if (satModalFrame) {
                    satModalFrame.src = url;
                    satModalFrame.onload = () => {
                        if (satModalLoader) satModalLoader.classList.add('hidden');
                        satModalFrame.classList.remove('hidden');
                    };
                }
            }

            satModal.classList.remove('hidden');
            satModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeSatTicketModal() {
            if (!satModal) return;
            satModal.classList.add('hidden');
            satModal.classList.remove('flex');
            if (satModalImg) {
                satModalImg.src = '';
                satModalImg.classList.add('hidden');
            }
            if (satModalFrame) {
                satModalFrame.src = '';
                satModalFrame.classList.add('hidden');
            }
            document.body.style.overflow = '';
        }

        (window as any).openSatTicketModal = openSatTicketModal;
        (window as any).closeSatTicketModal = closeSatTicketModal;

        if (satModalCloseBtn) satModalCloseBtn.addEventListener('click', closeSatTicketModal);
        if (satModalCloseFooter) satModalCloseFooter.addEventListener('click', closeSatTicketModal);
        if (satModal) {
            satModal.addEventListener('click', (e) => {
                if (e.target === satModal) closeSatTicketModal();
            });
        }
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && satModal && !satModal.classList.contains('hidden')) {
                closeSatTicketModal();
            }
        });

        // ====================================================
        // CAPTCHA DE SEGURIDAD
        // ====================================================
        let currentCaptchaCode = '';

        function generateCaptchaCode() {
            const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
            let code = '';
            for (let i = 0; i < 4; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return code;
        }

        function drawCaptcha() {
            // SIEMPRE generar el código primero (aunque el canvas no esté listo) para que la
            // validación nunca quede con un código vacío (eso permitía consultar sin captcha).
            currentCaptchaCode = generateCaptchaCode();

            const canvas = document.getElementById('captcha-canvas') as HTMLCanvasElement;
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            ctx.fillStyle = '#f8fafc';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.strokeStyle = 'rgba(0, 0, 0, 0.15)';
            for (let i = 0; i < 4; i++) {
                ctx.beginPath();
                ctx.moveTo(Math.random() * canvas.width, Math.random() * canvas.height);
                ctx.lineTo(Math.random() * canvas.width, Math.random() * canvas.height);
                ctx.stroke();
            }

            ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';
            for (let i = 0; i < 15; i++) {
                ctx.beginPath();
                ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, Math.random() * 4, 0, Math.PI * 2);
                ctx.fill();
            }

            const colors = ['#f59e0b', '#fbbf24', '#f59e0b', '#fbbf24', '#e2e8f0', '#38bdf8', '#f43f5e', '#34d399'];
            ctx.font = 'bold 22px "Archivo Black", sans-serif';
            ctx.textBaseline = 'middle';

            for (let i = 0; i < currentCaptchaCode.length; i++) {
                const char = currentCaptchaCode[i];
                ctx.fillStyle = colors[Math.floor(Math.random() * colors.length)];
                
                ctx.save();
                const x = 16 + i * 32 + Math.random() * 6;
                const y = canvas.height / 2 + (Math.random() * 8 - 4);
                const angle = (Math.random() * 30 - 15) * Math.PI / 180;
                
                ctx.translate(x, y);
                ctx.rotate(angle);
                ctx.fillText(char, 0, 0);
                ctx.restore();
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            drawCaptcha();

            const canvas = document.getElementById('captcha-canvas');
            const refreshBtn = document.getElementById('refresh-captcha-btn');

            if (canvas) canvas.addEventListener('click', drawCaptcha);
            if (refreshBtn) refreshBtn.addEventListener('click', drawCaptcha);
        });

        // ====================================================
        // FORMATO DE PLACA
        // ====================================================
        const plateInput = document.getElementById('plate-search-input') as HTMLInputElement;
        if (plateInput) {
            plateInput.addEventListener('input', () => {
                let val = plateInput.value.replace(/[^A-Za-z0-9-]/g, '').toUpperCase();
                const cleanVal = val.replace(/-/g, '');
                if (cleanVal.length === 6 && !val.includes('-')) {
                    val = cleanVal.slice(0, 3) + '-' + cleanVal.slice(3);
                }
                plateInput.value = val;
            });
        }

        // ====================================================
        // VEHICLE DATA ACCUMULATION
        // ====================================================
        let vehicleData: Record<string, string> = {};
        let queryAttempts: Record<string, number> = {};

        function processVehicleInfo(cardId: string, data: any) {
            if (!data) return;
            let updated = false;

            const isValEmpty = (val: any) => {
                if (val === undefined || val === null) return true;
                const clean = String(val).trim().toUpperCase();
                return clean === '' || clean === '—' || clean === 'N/A' || clean === 'NULL' || clean === 'UNDEFINED';
            };

            const setIfBetter = (key: string, val: any) => {
                if (val !== undefined && val !== null && String(val).trim() !== '') {
                    const currentVal = vehicleData[key];
                    if (isValEmpty(currentVal) && !isValEmpty(val)) {
                        vehicleData[key] = String(val).trim();
                        return true;
                    }
                }
                return false;
            };

            if (cardId === 'soat' && Array.isArray(data) && data.length > 0) {
                const cert = data[0];
                if (setIfBetter('marca', cert.Marca)) updated = true;
                if (setIfBetter('modelo', cert.ModeloVehiculo)) updated = true;
                if (setIfBetter('categoria', cert.NombreClaseVehiculo)) updated = true;
                if (setIfBetter('uso', cert.NombreUsoVehiculo)) updated = true;
            }

            if (cardId === 'citv' && Array.isArray(data) && data.length > 0) {
                const cert = data[0];
                if (setIfBetter('marca', cert.marca)) updated = true;
                if (setIfBetter('modelo', cert.modelo)) updated = true;
                if (setIfBetter('categoria', cert.clase)) updated = true;
                if (setIfBetter('anio', cert.anio)) updated = true;
            }

            if (cardId === 'atu' && data) {
                if (data.fuenteDato !== 'NOREGISTRADO') {
                    if (setIfBetter('marca', data.marcaSunarp)) updated = true;
                    if (setIfBetter('modelo', data.modeloSunarp)) updated = true;
                    if (setIfBetter('color', data.color)) updated = true;
                    if (setIfBetter('serie', data.serie)) updated = true;
                    if (setIfBetter('motor', data.motor)) updated = true;
                    if (setIfBetter('propietario', data.propietario)) updated = true;
                } else {
                    if (setIfBetter('marca', data.marcaSunarp)) updated = true;
                    if (setIfBetter('modelo', data.modeloSunarp)) updated = true;
                    if (setIfBetter('color', data.color)) updated = true;
                    if (setIfBetter('serie', data.serie)) updated = true;
                    if (setIfBetter('motor', data.motor)) updated = true;
                }
            }

            if (cardId === 'sunarp' && data) {
                if (setIfBetter('marca', data.Marca || data.marca)) updated = true;
                if (setIfBetter('modelo', data.Modelo || data.modelo)) updated = true;
                if (setIfBetter('color', data.Color || data.color)) updated = true;
                if (setIfBetter('anio', data.Año || data['Año Fabricación'] || data.anio)) updated = true;
                if (setIfBetter('propietario', data.Titular || data.Propietario || data.propietario)) updated = true;
            }

            if (cardId === 'placas_pe' && data) {
                if (setIfBetter('marca', data.marca)) updated = true;
                if (setIfBetter('modelo', data.modelo)) updated = true;
                if (setIfBetter('serie', data.serie)) updated = true;
                if (setIfBetter('propietario', data.propietario)) updated = true;
                if (setIfBetter('uso', data.tipoUso)) updated = true;
            }

            // La tarjeta "vehiculo" está en mantenimiento → no se re-renderiza aunque llegue
            // info de CITV/ATU. (Se seguirá acumulando en vehicleData por si se reactiva.)
            void updated;
        }

        // ====================================================
        // WRAPPER DE REINTENTOS PARA QUERIES
        // ====================================================
        async function runFetchWithRetry(
            cardId: string, 
            fetchCall: (callbacks: any) => Promise<any>, 
            plate: string, 
            attempt: number = 1,
            maxAttempts: number = 3
        ): Promise<any> {
            if (attempt === 1) {
                queryAttempts[cardId] = 1;
            }

            let resolveFn: any;
            let rejectFn: any;
            const promise = new Promise((resolve, reject) => {
                resolveFn = resolve;
                rejectFn = reject;
            });

            const customCallbacks = {
                setCardLoading: (id: string, title: string, sub: string, iconClass: string, bgColorClass: string, sourceName: string) => {
                    if (attempt > 1) {
                        setCardLoading(id, title, sub, iconClass, bgColorClass, `${sourceName} (Reintentando${attempt > 2 ? ' auto' : ''}...)`);
                    } else {
                        setCardLoading(id, title, sub, iconClass, bgColorClass, sourceName);
                    }
                },
                setCardData: (id: string, title: string, sub: string, iconClass: string, bgColorClass: string, sourceName: string, htmlContent: string, isSuccess: boolean, hasData: boolean, customBadge?: string) => {
                    setCardData(id, title, sub, iconClass, bgColorClass, sourceName, htmlContent, isSuccess, hasData, customBadge);
                },
                setCardError: async (id: string, title: string, sub: string, iconClass: string, bgColorClass: string, sourceName: string, errorMessage: string, plate: string) => {
                    const is404Error = (errorMessage || '').includes('404') || (errorMessage || '').includes('actualización') || (errorMessage || '').includes('no encontrada');
                    const isConnError = (errorMessage || '').includes('Failed to fetch') || (errorMessage || '').includes('NetworkError') || (errorMessage || '').includes('CONNECTION_REFUSED');

                    if (isConnError) {
                        const friendlyMsg = "No se puede conectar con el servidor backend (http://localhost:8000). Asegúrate de tener el backend iniciado.";
                        console.error(`[BACKEND DESCONECTADO] No hay conexión con el servidor backend para la consulta ${cardId}`);
                        setCardError(id, title, sub, iconClass, bgColorClass, sourceName, friendlyMsg, plate);
                        resolveFn({ success: false, error: friendlyMsg });
                        return;
                    }

                    // Solo errores 404 (sección inexistente) se eximen de reintento.
                    // El resto (incluyendo SUNARP, FISE, SBS, SAT, ATU, LUNAS) reintenta automáticamente.
                    const noRetry = is404Error;
                    if (noRetry) {
                        console.warn(`[INFO] Consulta ${cardId} finalizada sin reintento: ${errorMessage}`);
                        setCardError(id, title, sub, iconClass, bgColorClass, sourceName, errorMessage, plate);
                        resolveFn({ success: false, error: errorMessage });
                        return;
                    }
                    queryAttempts[id] = attempt;
                    if (attempt < maxAttempts) {
                        const delay = attempt === 1 ? 1500 : 3500;
                        console.warn(`[RETRY] Consulta ${cardId} falló (Intento ${attempt}/${maxAttempts}): ${errorMessage}. Reintentando en ${delay / 1000}s...`);
                        setCardLoading(id, title, sub, iconClass, bgColorClass, `${sourceName} (Reintentando ${attempt + 1}/${maxAttempts}...)`);
                        setTimeout(async () => {
                            try {
                                const retryResult = await runFetchWithRetry(cardId, fetchCall, plate, attempt + 1, maxAttempts);
                                resolveFn(retryResult);
                            } catch (e) {
                                rejectFn(e);
                            }
                        }, delay);
                    } else {
                        console.error(`[FINAL] Consulta ${cardId} falló definitivamente tras ${attempt} intentos: ${errorMessage}`);
                        setCardError(id, title, sub, iconClass, bgColorClass, sourceName, errorMessage, plate);
                        resolveFn({ success: false, error: errorMessage });
                    }
                },
                processVehicleInfo: (id: string, data: any) => {
                    processVehicleInfo(id, data);
                }
            };

            try {
                const res = await fetchCall(customCallbacks);
                if (res && res.success) {
                    resolveFn(res);
                }
            } catch (err) {
                console.error(`[CRASH] runFetchWithRetry catch error for ${cardId}:`, err);
                await customCallbacks.setCardError(
                    cardId, 
                    cardId.toUpperCase(), 
                    '', 
                    'fas fa-circle-exclamation', 
                    '', 
                    'Error', 
                    (err as any).message || 'Error inesperado', 
                    plate
                );
            }

            return promise;
        }

        // ====================================================
        // PETICIONES INDEPENDIENTES
        // ====================================================
        async function fetchSOAT(plate: string) {
            return runFetchWithRetry('soat', (callbacks) => runFetchSOAT(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchCITV(plate: string) {
            return runFetchWithRetry('citv', (callbacks) => runFetchCITV(plate, BACKEND_URL, callbacks), plate);
        }
        async function fetchLunas(plate: string) {
            // Lunas PNP: el backend ejecuta internamente hasta 15 intentos de BotDetect.
            // En frontend solo reintentamos max 2 veces para evitar bloquear la interfaz 4 minutos.
            return runExclusive('lunas', () =>
                runFetchWithRetry('lunas', (callbacks) => runFetchLunas(plate, BACKEND_URL, callbacks), plate, 1, 2));
        }

        async function fetchPNP(plate: string) {
            // Requisitorias Policiales PNP (Captura Vehicular)
            return runExclusive('pnp', () =>
                runFetchWithRetry('pnp_req', (callbacks) => runFetchPNP(plate, BACKEND_URL, callbacks), plate, 1, 2));
        }

        async function fetchCallao(plate: string) {
            return runFetchWithRetry('callao', (callbacks) => runFetchCallao(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchLima(plate: string) {
            // SAT Lima Papeletas (reCAPTCHA v2): el backend ejecuta 3 intentos con Chromium (85s).
            // En frontend se ejecuta 1 sola vez para evitar reintentar 3 veces consecutivas (~4 minutos).
            return runExclusive('lima', () =>
                runFetchWithRetry('lima', (callbacks) => runFetchLima(plate, BACKEND_URL, callbacks), plate, 1, 1));
        }

        async function fetchSutran(plate: string) {
            return runFetchWithRetry('sutran', (callbacks) => runFetchSutran(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchCinemometro(plate: string) {
            return runFetchWithRetry('cinemometro', (callbacks) => runFetchCinemometro(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchMunicipal(plate: string) {
            return runFetchWithRetry('municipal', (callbacks) => runFetchMunicipal(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchPlacasPE(plate: string) {
            return runFetchWithRetry('placas_pe', (callbacks) => runFetchPlacasPE(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchValorVenal(plate: string, marca?: string, modelo?: string, anio?: string) {
            return runFetchWithRetry('valor_venal', (callbacks) => runFetchValorVenal(plate, BACKEND_URL, callbacks, marca, modelo, anio), plate);
        }

        // Estado de Placa (placas.pe) + Valor Venal encadenados: el valor comercial usa la
        // marca/modelo REAL que devuelve la consulta de estado de placa.
        async function fetchEstadoPlacaYValor(plate: string) {
            let d: any = {};
            try {
                const pd = await fetchPlacasPE(plate);
                d = (pd && pd.data) ? pd.data : {};
            } catch (_e) {}
            const anio = d.anio || d.anioFabricacion || d['Año'] || '';
            await fetchValorVenal(plate, d.marca, d.modelo, anio);
        }

        async function fetchOsinergmin(plate: string) {
            return runFetchWithRetry('osinergmin', (callbacks) => runFetchOsinergmin(plate, BACKEND_URL, callbacks), plate);
        }

        // ====================================================
        // COLA SERIAL PARA SECCIONES PESADAS (navegador en el backend)
        // ====================================================
        // ATU, SBS, SAT y LUNAS comparten UN solo Chromium en el servidor
        // (semáforo global de 1). Si se lanzan solapadas, la segunda se queda
        // esperando hasta 90s por el semáforo y acaba en timeout o en
        // "The connection to the page has been disconnected".
        //
        // La fase 2 ya las llamaba con await, pero los reintentos automáticos
        // (setTimeout de 8s) y los clics en "Reintentar" se disparan sueltos y
        // sí se solapan. Esta cola serializa TODO: ejecución inicial, auto
        // reintentos y reintentos manuales.
        let heavyQueue: Promise<any> = Promise.resolve();
        function runExclusive<T>(label: string, fn: () => Promise<T>): Promise<T> {
            const run = () => {
                console.info(`[COLA] Iniciando ${label}`);
                return fn();
            };
            const next = heavyQueue.then(run, run);
            // La cola nunca debe romperse por un fallo de una sección
            heavyQueue = next.then(() => undefined, () => undefined);
            return next;
        }

        async function fetchATU(plate: string) {
            return runExclusive('atu', () =>
                runFetchWithRetry('atu', (callbacks) => runFetchATU(plate, BACKEND_URL, callbacks), plate));
        }

        async function fetchGNV(plate: string) {
            return runFetchWithRetry('gnv', (callbacks) => runFetchGNV(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchFISE(plate: string) {
            return runFetchWithRetry('fise', (callbacks) => runFetchFISE(plate, BACKEND_URL, callbacks), plate);
        }

        async function fetchSBS(plate: string) {
            return runExclusive('sbs', () =>
                runFetchWithRetry('sbs', (callbacks) => runFetchSBS(plate, BACKEND_URL, callbacks), plate));
        }

        async function fetchSUNARP(plate: string) {
            return runExclusive('sunarp', () =>
                runFetchWithRetry('sunarp', (callbacks) => runFetchSUNARP(plate, BACKEND_URL, callbacks), plate));
        }

        async function fetchSAT(plate: string) {
            // SAT llena 2 tarjetas (captura + depósito) en una sola consulta; tiene reintentos
            // internos (captcha) en el backend, así que se llama directo con callbacks simples.
            const callbacks = {
                setCardLoading: (id: string, t: string, s: string, i: string, b: string, src: string) => setCardLoading(id, t, s, i, b, src),
                setCardData: (id: string, t: string, s: string, i: string, b: string, src: string, html: string, ok: boolean, has: boolean, badge?: string) => setCardData(id, t, s, i, b, src, html, ok, has, badge),
                setCardError: (id: string, t: string, s: string, i: string, b: string, src: string, err: string, pl: string) => setCardError(id, t, s, i, b, src, err, pl),
            };
            return runExclusive('sat', () => runFetchSAT(plate, BACKEND_URL, callbacks));
        }

        async function fetchSATCaptura(plate: string) {
            const callbacks = {
                setCardLoading: (id: string, t: string, s: string, i: string, b: string, src: string) => setCardLoading(id, t, s, i, b, src),
                setCardData: (id: string, t: string, s: string, i: string, b: string, src: string, html: string, ok: boolean, has: boolean, badge?: string) => setCardData(id, t, s, i, b, src, html, ok, has, badge),
                setCardError: (id: string, t: string, s: string, i: string, b: string, src: string, err: string, pl: string) => setCardError(id, t, s, i, b, src, err, pl),
            };
            return runExclusive('sat', () => runFetchWithRetry('sat_captura', () => runFetchSATCaptura(plate, BACKEND_URL, callbacks), plate));
        }


            setCardData('lunas', 'Lunas Oscurecidas', '', 'fas fa-eye-slash', '', 'PNP', content, false, false);
        }

        async function fetchCallao(plate: string) {
            setCardLoading('callao', 'Papeletas Callao', '', 'fas fa-ticket', '', 'Mun. Callao');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 165000);
            try {
                const res = await fetch(`${BACKEND_URL}/callao/${plate}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data.success) {
                    const content = renderCallao(data.data, plate, data.total);
                    setCardData('callao', 'Papeletas Callao', '', 'fas fa-ticket', '', 'Mun. Callao', content, true, data.data?.length > 0);
                } else {
                    setCardError('callao', 'Papeletas Callao', '', 'fas fa-ticket', '', 'Mun. Callao', data.error || 'Error al consultar papeletas', plate);
                }
            } catch (err: any) {
                clearTimeout(timeoutId);
                const msg = err.name === 'AbortError' ? 'Tiempo de espera agotado.' : (err.message || 'Error de conexión');
                setCardError('callao', 'Papeletas Callao', '', 'fas fa-ticket', '', 'Mun. Callao', msg, plate);
            }
        }

        async function fetchLima(plate: string) {
            setCardLoading('lima', 'Papeletas Lima', '', 'fas fa-traffic-light', '', 'SAT Lima');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);
            try {
                const res = await fetch(`${BACKEND_URL}/lima/${plate}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                const content = renderLima(plate, data.message || 'Para consultar papeletas en Lima, ingresa directamente al portal SAT.', data.url || `https://sat.gob.pe/WebSiteWeb/Forms/frm040101/frm040101.aspx`);
                setCardData('lima', 'Papeletas Lima', '', 'fas fa-traffic-light', '', 'SAT Lima', content, true, false);
            } catch {
                const content = renderLima(plate, 'Para consultar papeletas en Lima, ingresa directamente al portal SAT.', `https://sat.gob.pe/WebSiteWeb/Forms/frm040101/frm040101.aspx`);
                setCardData('lima', 'Papeletas Lima', '', 'fas fa-traffic-light', '', 'SAT Lima', content, true, false);
            }
        }

        async function fetchSutran(plate: string) {
            setCardLoading('sutran', 'Papeletas SUTRAN', '', 'fas fa-road', '', 'SUTRAN');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 60000);
            try {
                const res = await fetch(`${BACKEND_URL}/sutran/${plate}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data.success) {
                    const content = renderSutran(data.data, plate, data.infoReporte || '');
                    setCardData('sutran', 'Papeletas SUTRAN', '', 'fas fa-road', '', 'SUTRAN', content, true, data.data?.length > 0);
                } else {
                    setCardError('sutran', 'Papeletas SUTRAN', '', 'fas fa-road', '', 'SUTRAN', data.error || 'Error al consultar SUTRAN', plate);
                }
            } catch (err: any) {
                clearTimeout(timeoutId);
                const msg = err.name === 'AbortError' ? 'Tiempo de espera agotado.' : (err.message || 'Error de conexión');
                setCardError('sutran', 'Papeletas SUTRAN', '', 'fas fa-road', '', 'SUTRAN', msg, plate);
            }
        }

        async function fetchATU(plate: string) {
            setCardLoading('atu', 'Habilitación ATU', '', 'fas fa-taxi', '', 'ATU');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);
            try {
                const res = await fetch(`${BACKEND_URL}/atu/${plate}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data.success) {
                    const content = renderAtu(data.data, plate);
                    const hasData = data.data && data.data.fuenteDato !== 'NOREGISTRADO' && data.data.estadoCertificado === 1;
                    setCardData('atu', 'Habilitación ATU', '', 'fas fa-taxi', '', 'ATU', content, true, hasData);
                } else {
                    setCardError('atu', 'Habilitación ATU', '', 'fas fa-taxi', '', 'ATU', data.error || 'Error al consultar habilitación', plate);
                }
            } catch (err: any) {
                clearTimeout(timeoutId);
                const msg = err.name === 'AbortError' ? 'Tiempo de espera agotado.' : (err.message || 'Error de conexión');
                setCardError('atu', 'Habilitación ATU', '', 'fas fa-taxi', '', 'ATU', msg, plate);
            }
        }

        (window as any).reintentarSeccion = async function(cardId: string, plate: string) {
            if (cardId === 'soat')   await fetchSOAT(plate);
            else if (cardId === 'citv')   await fetchCITV(plate);
            else if (cardId === 'lunas')  await fetchLunas(plate);
            else if (cardId === 'callao') await fetchCallao(plate);
            else if (cardId === 'lima')   await fetchLima(plate);
            else if (cardId === 'sutran') await fetchSutran(plate);
            else if (cardId === 'atu')    await fetchATU(plate);
        };

        // ====================================================
        // SUBMIT DEL FORMULARIO
        // ====================================================
        const queryForm = document.getElementById('query-form');
        const queryStatus = document.getElementById('query-status');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

        if (queryForm && plateInput && queryStatus) {
            queryForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const plate = plateInput.value.trim().toUpperCase();
                if (!plate) return;

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Consultando...';
                }
                queryStatus.textContent = 'Iniciando consulta multiorigen...';
                queryStatus.classList.remove('opacity-0');

                const rc = document.getElementById('results-container')!;
                rc.className = 'w-full bg-white rounded-2xl border-2 border-slate-100 p-6 md:p-8 shadow-lg text-left text-slate-900';
                rc.innerHTML = `
                    <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between mb-6 pb-4 border-b-2 border-slate-100">
                        <div>
                            <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-0.5">Placa consultada</p>
                            <p class="text-2xl font-extrabold text-slate-900 font-archivo tracking-wide">${plate}</p>
                        </div>
                        <div class="text-left sm:text-right">
                            <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-0.5">Fuentes consultadas</p>
                            <p class="text-xs md:text-sm font-bold text-slate-600">APESEG · MTC · Callao · SUTRAN · ATU</p>
                        </div>
                    </div>
                    <div id="results-cards-wrapper" class="flex flex-col gap-5 w-full">
                        <div id="soat-card-container" data-status="loading"></div>
                        <div id="citv-card-container" data-status="loading"></div>
                        <div id="lunas-card-container" data-status="loading"></div>
                        <div id="callao-card-container" data-status="loading"></div>
                        <div id="lima-card-container" data-status="loading"></div>
                        <div id="sutran-card-container" data-status="loading"></div>
                        <div id="atu-card-container" data-status="loading"></div>
                    </div>
                    <div class="mt-6 pt-4 border-t-2 border-slate-100 flex items-center justify-center gap-2">
                        <i class="fas fa-circle-info text-slate-300 text-xs"></i>
                        <p class="text-[11px] text-slate-400">Datos obtenidos en tiempo real · Última consulta: <strong class="text-slate-600 font-archivo">${plate}</strong> · <span id="last-query-time"></span></p>
                    </div>`;

                document.getElementById('last-query-time')!.textContent = new Date().toLocaleString('es-PE');

                Promise.all([
                    fetchSOAT(plate),
                    fetchCITV(plate),
                    fetchLunas(plate),
                    fetchCallao(plate),
                    fetchLima(plate),
                    fetchSutran(plate),
                    fetchATU(plate)
                ]).finally(() => {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fas fa-search"></i> Buscar';
                    }
                    queryStatus.classList.add('opacity-0');
                });
            });

            (window as any).abrirModalPapeleta = async function(nroPapeleta: string) {
                const modal = document.getElementById('papeleta-modal')!;
                const title = document.getElementById('modal-papeleta-title')!;
                const loading = document.getElementById('modal-loading')!;
                const error = document.getElementById('modal-error')!;
                const errorMsg = document.getElementById('modal-error-msg')!;
                const pdfViewer = document.getElementById('pdf-viewer') as HTMLIFrameElement;
                const imgViewer = document.getElementById('image-viewer') as HTMLImageElement;

                title.textContent = `Papeleta de Infracción N° ${nroPapeleta}`;
                modal.classList.remove('hidden');
                loading.classList.remove('hidden');
                error.classList.add('hidden');
                pdfViewer.classList.add('hidden');
                imgViewer.classList.add('hidden');
                pdfViewer.src = "";
                imgViewer.src = "";

                try {
                    const res = await fetch(`${BACKEND_URL}/callao/pdf/${nroPapeleta}`);
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const result = await res.json();
                    if (result.success && result.data) {
                        loading.classList.add('hidden');
                        const base64Data = result.data.trim();
                        if (base64Data.startsWith('JVBER')) {
                            pdfViewer.src = `data:application/pdf;base64,${base64Data}`;
                            pdfViewer.classList.remove('hidden');
                        } else if (base64Data.startsWith('/9j/') || base64Data.startsWith('iVBOR')) {
                            const mime = base64Data.startsWith('iVBOR') ? 'image/png' : 'image/jpeg';
                            imgViewer.src = `data:${mime};base64,${base64Data}`;
                            imgViewer.classList.remove('hidden');
                        } else {
                            if (nroPapeleta.endsWith('A') || nroPapeleta.endsWith('B')) {
                                imgViewer.src = `data:image/jpeg;base64,${base64Data}`;
                                imgViewer.classList.remove('hidden');
                            } else {
                                pdfViewer.src = `data:application/pdf;base64,${base64Data}`;
                                pdfViewer.classList.remove('hidden');
                            }
                        }
                    } else {
                        throw new Error(result.error || 'No se obtuvieron datos de la papeleta');
                    }
                } catch (err: any) {
                    loading.classList.add('hidden');
                    error.classList.remove('hidden');
                    errorMsg.textContent = err.message || 'Error de conexión con el servidor.';
                }
            };

            (window as any).cerrarModalPapeleta = function() {
                const modal = document.getElementById('papeleta-modal')!;
                modal.classList.add('hidden');
                const pdfViewer = document.getElementById('pdf-viewer') as HTMLIFrameElement;
                const imgViewer = document.getElementById('image-viewer') as HTMLImageElement;
                pdfViewer.src = "";
                imgViewer.src = "";
            };
        }
    </script>





    <!-- Modal para ver PDF/Imagen de Papeleta -->
    <div id="papeleta-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-slate-200 dark:border-white/10">
            <!-- Header -->
            <div class="px-5 py-4 border-b border-slate-200 dark:border-white/10 flex justify-between items-center bg-slate-50 dark:bg-slate-800/50">
                <h3 id="modal-papeleta-title" class="font-bold text-slate-800 dark:text-white text-base font-inter">Papeleta de Infracción</h3>
                <button onclick="window.cerrarModalPapeleta()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white transition-all text-xl p-1">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <!-- Body -->
            <div class="flex-1 overflow-auto p-5 min-h-[400px] flex items-center justify-center bg-slate-100 dark:bg-slate-900/30">
                <div id="modal-loading" class="hidden flex flex-col items-center gap-3">
                    <div class="w-10 h-10 rounded-full border-4 border-brand-yellow/20 border-t-brand-yellow animate-spin"></div>
                    <p class="text-xs text-slate-500 font-inter">Cargando documento desde el portal...</p>
                </div>
                <div id="modal-error" class="hidden text-center max-w-sm">
                    <i class="fas fa-exclamation-circle text-3xl text-red-500 mb-2 block"></i>
                    <p class="text-sm font-bold text-red-700 dark:text-red-400 font-inter">No se pudo cargar el documento</p>
                    <p id="modal-error-msg" class="text-xs text-slate-500 mt-1 font-inter"></p>
                </div>
                <iframe id="pdf-viewer" class="hidden w-full h-[65vh] border-0 rounded-lg shadow-sm" src=""></iframe>
                <img id="image-viewer" class="hidden max-w-full max-h-[65vh] object-contain rounded-lg shadow-sm" src="" alt="Papeleta" />
            </div>
        </div>
    </div>
</body>


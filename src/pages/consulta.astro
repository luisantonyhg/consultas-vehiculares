        // ====================================================
        // COLLAPSE/EXPAND ACCORDION FUNCTION (attached to window)
        // ====================================================
        (window as any).toggleAccordion = function(containerId: string) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const body = container.querySelector('.accordion-body');
            const chevron = container.querySelector('.accordion-chevron');
            const header = container.querySelector('.accordion-header');
            if (!body || !chevron || !header) return;

            const isHidden = body.classList.contains('hidden');
            if (isHidden) {
                // Expand
                body.classList.remove('hidden');
                chevron.classList.add('rotate-180');
                
                header.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white');
                header.classList.add('bg-gradient-to-r', 'from-[#1a3a6b]', 'to-[#0b1c36]', 'text-white', 'border-b-2', 'border-slate-900');
                
                const texts = header.querySelectorAll('.text-slate-900, .dark:text-white, .text-slate-400, .dark:text-slate-500');
                texts.forEach(el => {
                    if (el.classList.contains('text-slate-900') || el.classList.contains('dark:text-white')) {
                        el.classList.remove('text-slate-900', 'dark:text-white');
                        el.classList.add('text-white', 'temp-white-title');
                    } else {
                        el.classList.remove('text-slate-400', 'dark:text-slate-500');
                        el.classList.add('text-white/60', 'temp-white-sub');
                    }
                });
                
                const iconWrapper = header.querySelector('.w-10, .w-12');
                if (iconWrapper && !iconWrapper.hasAttribute('data-is-logo')) {
                    iconWrapper.setAttribute('data-orig-class', iconWrapper.className);
                    const cleanClasses = iconWrapper.className.split(' ').filter(c => !c.startsWith('bg-') && !c.startsWith('ring-') && !c.startsWith('text-')).join(' ');
                    iconWrapper.className = cleanClasses + ' bg-white/10 ring-1 ring-white/20 text-white';
                }
                const icon = iconWrapper?.querySelector('i');
                if (icon) {
                    icon.setAttribute('data-orig-class', icon.className);
                    const cleanIcon = icon.className.split(' ').filter(c => !c.startsWith('text-')).join(' ');
                    icon.className = cleanIcon + ' text-white';
                }
                
                chevron.classList.remove('text-slate-400', 'dark:text-slate-500');
                chevron.classList.add('text-white');
            } else {
                // Collapse
                body.classList.add('hidden');
                chevron.classList.remove('rotate-180');
                
                header.classList.remove('bg-gradient-to-r', 'from-[#1a3a6b]', 'to-[#0b1c36]', 'text-white', 'border-b-2', 'border-slate-900');
                header.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white');
                
                const textsTitle = header.querySelectorAll('.temp-white-title');
                textsTitle.forEach(el => {
                    el.classList.remove('text-white', 'temp-white-title');
                    el.classList.add('text-slate-900', 'dark:text-white');
                });
                const textsSub = header.querySelectorAll('.temp-white-sub');
                textsSub.forEach(el => {
                    el.classList.remove('text-white/60', 'temp-white-sub');
                    el.classList.add('text-slate-400', 'dark:text-slate-500');
                });
                
                const iconWrapper = header.querySelector('.w-10, .w-12');
                const origClass = iconWrapper?.getAttribute('data-orig-class');
                if (iconWrapper && origClass && !iconWrapper.hasAttribute('data-is-logo')) {
                    iconWrapper.className = origClass;
                }
                const icon = iconWrapper?.querySelector('i');
                const origIconClass = icon?.getAttribute('data-orig-class');
                if (icon && origIconClass) {
                    icon.className = origIconClass;
                }
                
                chevron.classList.remove('text-white');
                chevron.classList.add('text-slate-400', 'dark:text-slate-500');
            }
        };


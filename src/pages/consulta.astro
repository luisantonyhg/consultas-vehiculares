            const wasHidden = bodies.map(b => b.classList.contains('hidden'));
            bodies.forEach(b => b.classList.remove('hidden'));
            // Cabecera solo-print con marca y fecha
            let printHeader = document.getElementById('print-report-header');
            const resultsSection = document.getElementById('results-section');
            if (resultsSection && !printHeader) {
                printHeader = document.createElement('div');
                printHeader.id = 'print-report-header';
                printHeader.className = 'print-only';
                printHeader.style.cssText = 'margin-bottom:14px;padding-bottom:10px;border-bottom:2px solid #4f46e5;';
                resultsSection.prepend(printHeader);
            }
            if (printHeader) {
                const fecha = new Date().toLocaleString('es-PE');
                printHeader.innerHTML =
                    '<div style="display:flex;justify-content:space-between;align-items:flex-end;">' +
                        '<div>' +
                            '<h1 style="font-size:20px;font-weight:800;color:#0f172a;margin:0;">Reporte Vehicular</h1>' +
                            '<p style="font-size:12px;color:#475569;margin:2px 0 0;">Placa <b>' + plate + '</b> · Consulta multifuente</p>' +
                        '</div>' +
                        '<p style="font-size:11px;color:#64748b;margin:0;">Generado: ' + fecha + '</p>' +
                    '</div>';
            }
            setTimeout(() => {
                window.print();
                // Restaurar el estado de las tarjetas tras imprimir
                setTimeout(() => bodies.forEach((b, i) => { if (wasHidden[i]) b.classList.add('hidden'); }), 400);
            }, 200);
        };

        // ====================================================
        // 🟢 COMPARTIR POR WHATSAPP como IMAGEN estilo "Yape" (no texto feo)
        // ====================================================
        // Recolecta las secciones con datos y su estado (icono + color).
        function recolectarResumen() {
            const items: {titulo:string, estado:string, tipo:string}[] = [];
            const cards = document.querySelectorAll('#results-cards-wrapper > div');
            cards.forEach(card => {
                const h3 = card.querySelector('h3');
                if (!h3) return;
                const titulo = (h3.textContent || '').trim();
                const status = card.getAttribute('data-status') || '';
                if (!titulo || status === 'loading' || status === 'maintenance' || status === 'development') return;
                let estado = '';
                card.querySelectorAll('span').forEach(b => {
                    const t = (b.textContent || '').trim();
                    if (t && t.length < 30 && !estado) estado = t;
                });
                const e = estado.toUpperCase();
                let tipo = 'neutral';
                if (/ACTIVO|VIGENTE|HABILITADO|SIN SINIESTROS|SIN GRAVAMEN|REGISTRADO|APROBADO/.test(e)) tipo = 'ok';
                else if (/VENCIDO|ANULADO|PAPELETA|INFRACC|SINIESTRO|NO HABILITADO/.test(e)) tipo = 'warn';
                items.push({ titulo, estado, tipo });
            });
            return items;
        }

        // Construye la tarjeta visual (estilo comprobante Yape). Se renderiza VISIBLE
        // dentro del modal (en pantalla) para que html-to-image la capture completa.
        function construirTarjetaImagen(plate: string) {
            const items = recolectarResumen();
            const fecha = new Date().toLocaleDateString('es-PE', { day:'2-digit', month:'long', year:'numeric' });
            const filas = items.map(it => {
                const color = it.tipo === 'ok' ? '#10b981' : it.tipo === 'warn' ? '#f59e0b' : '#94a3b8';
                const icon  = it.tipo === 'ok' ? '✓' : it.tipo === 'warn' ? '!' : '•';
                return `<div style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.09);border-radius:14px;margin-bottom:8px;">
                    <div style="width:26px;height:26px;border-radius:50%;background:${color};color:#0b1220;font-weight:900;font-size:15px;line-height:26px;text-align:center;flex-shrink:0;">${icon}</div>
                    <div style="flex:1;min-width:0;">
                        <div style="color:#e2e8f0;font-size:14px;font-weight:700;line-height:1.25;">${it.titulo}</div>
                        ${it.estado ? `<div style="color:${color};font-size:12px;font-weight:800;letter-spacing:.4px;margin-top:2px;">${it.estado.toUpperCase()}</div>` : ''}
                    </div>
                </div>`;
            }).join('');

            const card = document.createElement('div');
            card.id = 'share-card-render';
            card.style.cssText = 'width:100%;max-width:400px;margin:0 auto;padding:26px 22px 18px;box-sizing:border-box;font-family:Poppins,system-ui,sans-serif;background:linear-gradient(160deg,#111827 0%,#0b1220 55%,#1e1b4b 130%);border-radius:22px;';
            card.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#6366f1,#8b5cf6);text-align:center;line-height:42px;font-size:21px;">🚗</div>

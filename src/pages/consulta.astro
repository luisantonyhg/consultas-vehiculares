---
// Vista de consulta específica por placa - Integrada con el Backend real
import SiteNav from '../components/common/SiteNav.astro';
import MaintenanceModal from '../components/MaintenanceModal.astro';
import DniResults from '../components/DniResults.astro';
import ConsultationHero from '../components/consulta/ConsultationHero.astro';
import ConsultationOverlays from '../components/consulta/ConsultationOverlays.astro';
import ConsultationFooter from '../components/consulta/ConsultationFooter.astro';
import '../styles/consulta.css';
import { SITE_LANG, SITE_LOCALE, SITE_THEME_COLOR, SITE_OG_IMAGE, TWITTER_SITE, canonicalFor } from '../data/site';
const pageUrl = canonicalFor('/consulta');
const ogImage = canonicalFor(SITE_OG_IMAGE);
---

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/jpeg" href="/assets/logocañitaoficial2026.png" />
    <link rel="apple-touch-icon" href="/assets/logocañitaoficial2026.png" />
    <meta name="theme-color" content={SITE_THEME_COLOR} />
    <title>Cañita | Consultar Placa o DNI en Perú — Resultados en Tiempo Real</title>
    <meta name="description" content="Consulta tu placa o DNI en Cañita: SOAT, CITV, SUNARP, papeletas, RUC, multas JNE y licencias MTC con resultados en tiempo real.">
    <meta name="keywords" content="cañita, consultar placa, consultar dni, resultados vehiculares, SOAT vigente, CITV, papeletas SAT, multas JNE">
    <meta name="author" content="Luis Antony Huamani Gonzales">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang={SITE_LANG} href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    {/* Open Graph / Facebook / WhatsApp */}
    <meta property="og:site_name" content="CAÑITA - Consultas Vehiculares y DNI">
    <meta property="og:type" content="website">
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content="Cañita | Consultar Placa o DNI en Perú">
    <meta property="og:description" content="Resultados en tiempo real por placa o DNI: SOAT, CITV, SUNARP, papeletas, RUC, JNE y MTC.">
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="600">
    <meta property="og:image:height" content="600">
    <meta property="og:image:alt" content="Logo Oficial Cañita Consultas Vehiculares y DNI">

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content={TWITTER_SITE}>
    <meta name="twitter:title" content="Cañita | Consultar Placa o DNI en Perú">
    <meta name="twitter:description" content="Resultados en tiempo real por placa o DNI en Perú.">
    <meta name="twitter:image" content={ogImage} />

    {/* Structured Data (JSON-LD) */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://consultas-vehiculares.vercel.app/#person",
            "name": "Luis Antony Huamani Gonzales",
            "alternateName": "Huamani Gonzales Luis Antony",
            "jobTitle": "Ingeniero de Sistemas",
            "description": "Ingeniero de Sistemas y Desarrollador de Software especializado en desarrollo web premium y consumo de servicios públicos descentralizados.",
            "knowsAbout": ["Ingeniería de Sistemas", "Desarrollo Web", "Astro", "TypeScript", "Node.js", "Python", "Bases de Datos", "APIs"],
            "sameAs": [
              "https://github.com/luisantonyhg"
            ]
          },
          {
            "@type": "SoftwareApplication",
            "name": "Módulo de Consulta Vehicular por Placa",
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Web",
            "description": "Servicio de consulta de placas vehiculares integrado en tiempo real con captcha de seguridad.",
            "creator": {
              "@type": "Person",
              "name": "Luis Antony Huamani Gonzales"
            }
          }
        ]
      }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Dancing+Script:wght@700&family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

</head>

<body class="text-slate-800 transition-colors duration-300 min-h-screen font-poppins flex flex-col pb-10" style="background: linear-gradient(180deg, #fdfbf7 0%, #f7f2e7 400px, #f4eee2 100%);">

    {/* Modal de Novedades y Actualizaciones (Desactivado/Comentado)
    <div id="updates-modal" class="fixed inset-0 z-[140] hidden items-center justify-center bg-slate-900/60 p-3 sm:p-4 backdrop-blur-sm transition-all duration-300 font-poppins" role="dialog" aria-modal="true" aria-labelledby="updates-modal-title">
        <div class="relative w-full max-w-[460px] overflow-hidden rounded-2xl bg-white text-slate-900 shadow-2xl border border-slate-200">
            <!-- Header Blanco y Elegante -->
            <div class="flex items-center justify-between border-b border-slate-100 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2.5">
                    <img src="/assets/logocañitaoficial2026.png" alt="Logo Cañita" class="h-6 w-auto rounded object-contain" />
                    <div>
                        <h2 id="updates-modal-title" class="text-sm font-extrabold tracking-tight text-slate-900 leading-tight">
                            Nuevas Actualizaciones Setiembre
                        </h2>
                        <p class="text-[10px] text-slate-400 font-medium">Validaciones oficiales en tiempo real · v2026</p>
                    </div>
                </div>
                <button id="updates-modal-close" type="button" aria-label="Cerrar ventana" class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-400 hover:bg-slate-200 hover:text-slate-700 transition active:scale-95 cursor-pointer">
                    <i class="fas fa-xmark text-xs"></i>
                </button>
            </div>

            <!-- Listado Compacto con Logos Oficiales Reales -->
            <div class="space-y-2 p-4 text-left">
                <!-- Ítem 1: Papeletas Otras Municipalidades -->
                <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50/60 p-2.5 hover:bg-slate-50 transition">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white border border-slate-200 p-1 shadow-xs">
                        <img src="/assets/munlima.png" alt="Municipalidades" class="h-full w-full object-contain" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-1">
                            <h3 class="text-xs font-bold text-slate-800 truncate">Papeletas Otras Municipalidades</h3>
                            <span class="rounded bg-blue-50 px-1.5 py-0.5 text-[9px] font-extrabold text-blue-600 border border-blue-100 shrink-0">12 Provincias</span>
                        </div>
                        <p class="text-[10px] text-slate-500 leading-tight truncate">Huancayo, Huánuco, Arequipa, Cusco, Piura, Tacna y más.</p>
                    </div>
                </div>

                <!-- Ítem 2: Garantías Mobiliarias SIGM SUNARP -->
                <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50/60 p-2.5 hover:bg-slate-50 transition">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white border border-slate-200 p-1 shadow-xs">
                        <img src="/assets/sunarp.jpeg" alt="SUNARP" class="h-full w-full object-contain" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-1">
                            <h3 class="text-xs font-bold text-slate-800 truncate">Garantías Mobiliarias SUNARP</h3>
                            <span class="rounded bg-amber-50 px-1.5 py-0.5 text-[9px] font-extrabold text-amber-700 border border-amber-200 shrink-0">SIGM Oficial</span>
                        </div>
                        <p class="text-[10px] text-slate-500 leading-tight truncate">Verifica si el vehículo está prendado o tiene afectaciones.</p>
                    </div>
                </div>

                <!-- Ítem 3: Deuda GNV (FISE Ahorro GNV) -->
                <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50/60 p-2.5 hover:bg-slate-50 transition">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white border border-slate-200 p-1 shadow-xs">
                        <img src="/assets/fise.png" alt="FISE" class="h-full w-full object-contain" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-1">
                            <h3 class="text-xs font-bold text-slate-800 truncate">Deuda GNV (FISE Ahorro GNV)</h3>
                            <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[9px] font-extrabold text-emerald-700 border border-emerald-200 shrink-0">MINEM</span>
                        </div>
                        <p class="text-[10px] text-slate-500 leading-tight truncate">Saldos pendientes, cronograma y recaudos en grifos.</p>
                    </div>
                </div>

                <!-- Ítem 4: Requisitoria Policial PNP Asistida -->
                <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50/60 p-2.5 hover:bg-slate-50 transition">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white border border-slate-200 p-1 shadow-xs">
                        <img src="/assets/logopnp.png" alt="PNP" class="h-full w-full object-contain" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-1">
                            <h3 class="text-xs font-bold text-slate-800 truncate">Requisitoria Policial PNP</h3>
                            <span class="rounded bg-rose-50 px-1.5 py-0.5 text-[9px] font-extrabold text-rose-600 border border-rose-200 shrink-0">WhatsApp</span>
                        </div>
                        <p class="text-[10px] text-slate-500 leading-tight truncate">Asesoría asistida para antecedentes policiales y capturas.</p>
                    </div>
                </div>

                <!-- Ítem 5: ANÁLISIS INTELIGENTE DEL VEHÍCULO -->
                <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50/60 p-2.5 hover:bg-slate-50 transition">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white border border-slate-200 p-1 shadow-xs">
                        <img src="/assets/logocañitaoficial2026.png" alt="Cañita AI" class="h-full w-full object-contain" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-1">
                            <h3 class="text-xs font-bold text-slate-800 truncate">ANÁLISIS INTELIGENTE DEL VEHÍCULO</h3>
                            <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[9px] font-extrabold text-emerald-700 border border-emerald-200 shrink-0">Al Final</span>
                        </div>
                        <p class="text-[10px] text-slate-500 leading-tight truncate">Índice integral de salud cruzando las 20 fuentes oficiales.</p>
                    </div>
                </div>
            </div>

            <!-- Footer Blanco y Compacto -->
            <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50/70 px-5 py-3">
                <span class="text-[10px] font-semibold text-slate-400">Consultas actualizadas en tiempo real</span>
                <button id="updates-modal-accept" type="button" class="inline-flex items-center gap-1.5 rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-black transition active:scale-95 cursor-pointer">
                    <span>Entendido</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </button>
            </div>
        </div>
    </div>
    */}

    <main class="w-full flex-1 flex flex-col items-center relative">
        <SiteNav active="placa" />

        <ConsultationHero />

        {/* Sección de Resultados con Recordatorio de Marca Cañita */}
        <div id="results-section" class="w-full max-w-[1100px] mt-8 px-5 md:px-[15px] z-10">
            <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-6 gap-2">
                <div class="flex items-center gap-3 text-slate-800">
                    <i class="fas fa-chart-line text-brand-red text-xl"></i>
                    <h2 class="text-base sm:text-xl font-bold tracking-wide font-poppins">Resultados del Análisis</h2>
                </div>
                <div class="flex items-center gap-1.5 shrink-0 select-none">
                    <div class="w-6 h-6 rounded-md bg-white border border-slate-200 shadow-xs flex items-center justify-center p-0.5">
                        <img src="/assets/logocañitaoficial2026.png" class="w-full h-full object-contain rounded" alt="Logo Cañita" />
                    </div>
                    <span class="text-slate-850 dark:text-slate-200 font-archivo text-[11px] md:text-xs font-black tracking-tight">CAÑITA</span>
                </div>
            </div>

            {/* Estado inicial */}
            <div
                id="results-container"
                class="w-full max-w-3xl md:max-w-4xl mx-auto text-center py-12 px-6 sm:px-12 md:px-16 rounded-3xl border border-dashed border-slate-200 bg-white shadow-md text-slate-900 font-poppins"
            >
                <i class="fas fa-folder-open text-4xl text-slate-300 mb-3.5 block"></i>
                <p class="font-extrabold text-slate-755 text-lg">Esperando Placa Vehicular</p>
                <p class="text-xs text-slate-500 mt-1 max-w-[300px] mx-auto leading-relaxed">
                    Ingresa una placa arriba para realizar un análisis vehicular integral en tiempo real.
                </p>
            </div>
        </div>

        {/* Componente Modular de Resultados DNI */}
        <DniResults />

    </main>

    {/* Footer */}
    <ConsultationFooter />

    <ConsultationOverlays />


    <script src="../scripts/consulta/consulta-controller.ts"></script>
    <!-- Modal para ver PDF/Imagen de Papeleta -->
    <div id="papeleta-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-slate-200 dark:border-white/10">
            <!-- Header -->
            <div class="px-5 py-4 border-b border-slate-200 dark:border-white/10 flex justify-between items-center bg-slate-50 dark:bg-slate-800/50">
                <h3 id="modal-papeleta-title" class="font-bold text-slate-800 dark:text-white text-base font-inter">Papeleta de Infracción</h3>
                <button onclick="window.cerrarModalPapeleta()" class="text-slate-400 hover:text-slate-655 dark:hover:text-white transition-all text-xl p-1">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <!-- Body -->
            <div class="flex-1 overflow-auto p-5 min-h-[400px] flex items-center justify-center bg-slate-100 dark:bg-slate-900/30">
                <div id="modal-loading" class="hidden flex flex-col items-center gap-3">
                    <div class="w-10 h-10 rounded-full border-4 border-brand-yellow/20 border-t-brand-yellow animate-spin"></div>
                    <p class="text-xs text-slate-500 font-inter">Cargando documento desde el portal...</p>
                </div>
                <div id="modal-error" class="hidden text-center max-w-sm">
                    <i class="fas fa-exclamation-circle text-3xl text-red-500 mb-2 block"></i>
                    <p class="text-sm font-bold text-red-700 dark:text-red-400 font-inter">No se pudo cargar el documento</p>
                    <p id="modal-error-msg" class="text-xs text-slate-500 mt-1 font-inter"></p>
                </div>
                <iframe id="pdf-viewer" class="hidden w-full h-[65vh] border-0 rounded-lg shadow-sm" src=""></iframe>
                <div id="pdf-canvas-viewer" class="hidden w-full max-h-[65vh] overflow-auto rounded-lg bg-slate-200 p-2"></div>
                <img id="image-viewer" class="hidden max-w-full max-h-[65vh] object-contain rounded-lg shadow-sm" alt="Papeleta" />
            </div>
        </div>
    </div>

    <MaintenanceModal />
    <script is:inline src="/version-check.js"></script>
</body>

</html>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: #0b1c36;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .main-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            padding-bottom: 40px;
        }

        /* --- SECCIÓN BANNER SUPERIOR --- */
        .banner-section {
            width: 100%;
            background: radial-gradient(circle, #1a3a6b 0%, #0b1c36 100%);
            padding: 40px 20px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
            margin-bottom: 0px;
        }

        .banner-container {
            max-width: 1100px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .banner-content {
            text-align: center;
            flex: 1;
            z-index: 2;
        }

        .car-img {
            max-width: 300px;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5));
            z-index: 1;
        }

        .car-left {
            transform: translateX(-20px);
        }

        .car-right {
            transform: translateX(20px);
        }

        .banner-title {
            color: #ffd000;
            text-transform: uppercase;
            font-family: 'Archivo Black', sans-serif;
            font-size: 55px;
            font-style: italic;
            line-height: 0.9;
            margin: 0;
            letter-spacing: -2px;
            text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.5);
        }

        .banner-subtitle {
            color: #ffd000;
            font-family: 'Dancing Script', cursive;
            font-size: 40px;
            margin: -5px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .banner-subtitle span.normal {
            font-size: 25px;
            color: #fff;
            font-family: 'Dancing Script', cursive;
        }

        .banner-footer-text {
            color: #fff;
            font-size: 18px;
            margin-top: 15px;
            font-weight: 500;
        }

        .banner-footer-text strong {
            font-weight: 800;
        }

        .author-name {
            color: #fff;
            font-size: 22px;
            margin-top: 5px;
            font-weight: 300;
            margin-bottom: 10px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 5px;
        }

        .social-links a {
            color: #ffffff;
            font-size: 28px;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            color: #ffd000;
            transform: translateY(-3px) scale(1.1);
        }

        .section-subtitle {
            max-width: 1100px;
            width: 100%;
            margin: 20px auto 20px;
            padding: 0 5vw;
            display: flex;
            align-items: center;
            gap: 15px;
            color: #ffffff;
        }

        .section-subtitle h2 {
            font-size: 24px;
            font-weight: 700;
            white-space: nowrap;
        }

        .section-subtitle::after {
            content: "";
            height: 2px;
            background: linear-gradient(to right, #e31837, transparent);
            width: 100%;
            border-radius: 2px;
        }

        .section-subtitle i {
            color: #e31837;
            font-size: 24px;
            font-family: "Font Awesome 6 Free" !important;
            font-weight: 900 !important;
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            max-width: 1100px;
            width: 100%;
            padding: 0 5vw;
            margin-bottom: 25px;
        }

        /* Diseño individual de la Tarjeta */
        .service-card {
            background: linear-gradient(135deg, #42d9e8 0%, #1045b0 100%);
            border-radius: 15px;
            padding: 12px 18px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            min-height: 100px;
            transition: all 0.3s ease;
            text-decoration: none;
            cursor: pointer;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            filter: brightness(1.1);
        }

        .service-logo-container {
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 2;
        }

        .service-logo-container img {
            height: 65px;
            object-fit: contain;
            border-radius: 8px;
        }

        .service-title {
            font-size: 16px;
            font-weight: 800;
            text-align: center;
            flex: 1;
            margin-left: 10px;
            line-height: 1.1;
            z-index: 2;
        }

        .service-watermark {
            position: absolute;
            bottom: 10px;
            left: 15px;
            font-size: 24px;
            font-weight: 900;
            opacity: 0.15;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
            pointer-events: none;
            z-index: 1;
        }

        /* --- FOOTER SECCIÓN --- */
        .page-footer {
            margin-top: 60px;
            padding: 40px 0;
            background: rgba(11, 28, 54, 0.9);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(227, 24, 55, 0.3);
            text-align: center;
            color: #ffffff;
            width: 100%;
        }

        .footer-content {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .realizado-por {
            font-size: 14px;
            color: #8892a3;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .footer-author {
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 20px;
        }

        /* --- RESPONSIVIDAD EXTREMA PARA CELULARES --- */
        @media (max-width: 768px) {
            .banner-section {
                padding: 15px 10px 5px;
            }

            .banner-container {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                gap: 5px;
                padding: 0 10px;
            }

            .car-img {
                max-width: 80px;
                margin-top: 0;
                transform: none;
            }

            .car-left {
                order: 1;
                margin-left: -5px;
            }

            .car-right {
                order: 2;
                margin-right: -5px;
            }

            .banner-content {
                order: 3;
                width: 100%;
                margin-top: -10px;
            }

            .banner-title {
                font-size: 32px;
            }

            .banner-subtitle {
                font-size: 24px;
            }

            .banner-subtitle span.normal {
                font-size: 16px;
            }

            .banner-footer-text {
                font-size: 12px;
            }

            .author-name {
                font-size: 14px;
                margin-bottom: 5px;
            }

            .social-links a {
                font-size: 24px;
            }

            .social-links {
                gap: 15px;
            }

            .page-footer {
                margin-top: 40px;
                padding: 30px 15px;
            }

            .footer-author {
                font-size: 18px;
            }

            .section-subtitle {
                margin: 15px auto 15px;
                padding: 0 20px;
                gap: 10px;
            }

            .section-subtitle h2 {
                font-size: 18px;
            }

            .section-subtitle i {
                font-size: 18px;
            }

            .service-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
                padding: 0 15px;
            }

            .service-card {
                padding: 6px 10px;
                min-height: 65px;
                flex-direction: row;
                align-items: center;
                justify-content: flex-start;
                border-radius: 10px;
            }

            .service-logo-container img {

---
import ServiceCard from '../components/ServiceCard.astro';
import MaintenanceModal from '../components/MaintenanceModal.astro';
import SiteNav from '../components/common/SiteNav.astro';
import { SERVICES_DATA } from '../data/services';
import { SITE_URL, SITE_NAME, SITE_LANG, SITE_LOCALE, SITE_THEME_COLOR, SITE_LOGO, SITE_OG_IMAGE, TWITTER_SITE, canonicalFor } from '../data/site';
const pageUrl = canonicalFor('/');
const ogImage = canonicalFor(SITE_OG_IMAGE);
---

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/jpeg" href="/assets/logocañitaoficial2026.png" />
    <link rel="apple-touch-icon" href="/assets/logocañitaoficial2026.png" />
    <meta name="theme-color" content={SITE_THEME_COLOR} />
    <title>Cañita | Consulta Vehicular por Placa y DNI en Perú</title>
    <meta name="description" content="Cañita: consulta vehicular por placa (SUNARP, SOAT, CITV, SUTRAN, SAT, ATU) y consulta por DNI (identidad, RUC, multas JNE, licencias MTC) en Perú, rápido y gratis.">
    <meta name="keywords" content="cañita, canita, consulta vehicular, consulta por placa, buscar placa perú, consulta dni, consulta dni perú, SUNARP, SOAT, CITV, SUTRAN, SAT Lima, Callao, ATU, papeletas, multas JNE, licencia conducir MTC, RUC SUNAT">
    <meta name="author" content="Luis Antony Huamani Gonzales">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang={SITE_LANG} href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    {/* Open Graph / Facebook / WhatsApp */}
    <meta property="og:site_name" content="CAÑITA - Consultas Vehiculares y DNI">
    <meta property="og:type" content="website">
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content="Cañita | Consulta Vehicular por Placa y DNI en Perú">
    <meta property="og:description" content="Consulta placas (SUNARP, SOAT, CITV, SUTRAN, SAT, ATU) y DNI (identidad, RUC, JNE, MTC, MINEDU) en un solo lugar.">
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="600">
    <meta property="og:image:height" content="600">
    <meta property="og:image:alt" content="Logo Oficial Cañita Consultas Vehiculares y DNI">

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content={TWITTER_SITE}>
    <meta name="twitter:title" content="Cañita | Consulta Vehicular por Placa y DNI en Perú">
    <meta name="twitter:description" content="Consulta placas y DNI en Perú: SUNARP, SOAT, SUTRAN, CITV, SAT, JNE, MTC y más.">
    <meta name="twitter:image" content={ogImage} />

    {/* Structured Data (JSON-LD) */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": pageUrl + "#website",
          "url": pageUrl,
          "name": SITE_NAME + " - Consultas Vehiculares y DNI Perú",
          "inLanguage": SITE_LANG,
          "potentialAction": {
            "@type": "SearchAction",
            "target": { "@type": "EntryPoint", "urlTemplate": canonicalFor('/consulta') },
            "query-input": "required name=query"
          }
        },
        {
          "@type": "Organization",
          "@id": pageUrl + "#org",
          "name": SITE_NAME,
          "url": pageUrl,
          "logo": { "@type": "ImageObject", "url": canonicalFor(SITE_LOGO) }
        },
        {
          "@type": "WebApplication",
          "name": "Cañita - Consultas Vehiculares y DNI Perú",
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "All",
          "url": pageUrl,
          "description": "Centraliza consultas públicas en tiempo real: placas (SUNARP, SOAT, CITV, SUTRAN, SAT, ATU) y DNI (identidad, RUC, JNE, MTC, MINEDU).",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "PEN" },
          "creator": { "@type": "Person", "name": "Luis Antony Huamani Gonzales" }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            { "@type": "Question", "name": "¿Qué es Cañita?", "acceptedAnswer": { "@type": "Answer", "text": "Cañita es una plataforma peruana de consultas vehiculares por placa y consultas por DNI que unifica fuentes públicas oficiales en tiempo real." } },
            { "@type": "Question", "name": "¿Cómo consultar una placa vehicular en Perú?", "acceptedAnswer": { "@type": "Answer", "text": "Ingresa la placa (ej. ABC-123) en el buscador de Cañita y obtendrás SOAT, CITV, SUNARP, papeletas SUTRAN/SAT/Callao y más." } },
            { "@type": "Question", "name": "¿Cómo consultar por DNI?", "acceptedAnswer": { "@type": "Answer", "text": "Ingresa los 8 dígitos del DNI para ver identidad, RUC SUNAT, multas JNE, licencias MTC, títulos MINEDU y presencia digital." } },
            { "@type": "Question", "name": "¿Consultar en Cañita es gratis?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, la consulta básica por placa o DNI en Cañita es gratuita." } },
            { "@type": "Question", "name": "¿De qué fuentes obtiene datos Cañita?", "acceptedAnswer": { "@type": "Answer", "text": "SUNARP, APESEG/SOAT, MTC, SUTRAN, SAT Lima, Callao, ATU, JNE, SUNAT, MINEDU, OSCE y fuentes abiertas, según disponibilidad oficial." } }
          ]
        }
      ]
    })} />

    {/* Fuentes Google y FontAwesome */}
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700;800;900&family=Dancing+Script:wght@700&family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .font-archivo { font-family: 'Archivo Black', sans-serif; }
        .font-dancing { font-family: 'Dancing Script', cursive; }
        .font-inter { font-family: 'Inter', sans-serif; }

        /* Banner Scenery */
        .banner-luxury-bg {
            background-color: #fdfbf7;
            background-image: url('/assets/fondoweb.png');
            background-size: cover;
            background-position: center top;
            background-repeat: no-repeat;
            position: relative;
        }

        .home-hero-copy {
            background: rgba(255, 252, 246, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 20px;
            box-shadow: 0 10px 32px rgba(42, 28, 9, 0.14);
            backdrop-filter: blur(10px);
        }

        @media (max-width: 767px) {
            .banner-luxury-bg {
                background-color: #fdfbf7;
                background-image: url('/assets/fondomodomovil.png'), radial-gradient(circle at 80% 20%, #ffe9c7 0%, #fdfbf7 75%);
                background-size: cover, cover;
                background-position: top right, center;
                background-repeat: no-repeat;
            }
        }

        .search-card-gold {
            background: #ffffff;
            border: 1px solid rgba(212, 175, 55, 0.45);
            box-shadow: 0 16px 45px -8px rgba(160, 110, 30, 0.20), 0 4px 15px rgba(0, 0, 0, 0.04);
            border-radius: 26px;
        }

        .btn-gold-action {
            background: linear-gradient(135deg, #f7d88c 0%, #e5b958 45%, #c8952d 100%);
            color: #3b2302 !important;
            border: 1px solid rgba(255, 235, 175, 0.85);
            box-shadow: 0 8px 24px rgba(200, 149, 45, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            transition: all 0.25s ease;
        }
        .btn-gold-action:hover {
            background: linear-gradient(135deg, #fae4ad 0%, #edd075 45%, #d6a133 100%);
            color: #2b1800 !important;
            box-shadow: 0 10px 28px rgba(200, 149, 45, 0.42);
            transform: translateY(-1px);
        }
        .btn-gold-action:active { transform: scale(0.98); }

        .tab-active-gold {
            background: linear-gradient(135deg, #ba812e 0%, #9e671b 50%, #7f4e0e 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(158, 103, 27, 0.32) !important;
        }
        .tab-inactive-gold {
            background: transparent !important;
            color: #475569 !important;
        }
        .tab-inactive-gold:hover { color: #0f172a !important; }

        .scan-plate-card {
            background: #fdfbf7;
            border: 1.5px solid rgba(212, 175, 55, 0.4);
            border-radius: 16px;
            transition: all 0.2s ease;
        }
        .scan-plate-card:hover {
            background: #faf4e6;
            border-color: rgba(212, 175, 55, 0.7);
            transform: translateY(-1px);
        }

        .plate-input-card {
            transition: transform 0.2s ease, box-shadow 0.25s ease;
        }
        .plate-input-card:focus-within {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -8px rgba(0, 0, 0, 0.5), 0 0 0 3px rgba(255, 208, 0, 0.45);
        }
    </style>
</head>

<body class="bg-[#fbf8f2] text-slate-800 transition-colors duration-300 min-h-screen font-poppins flex flex-col pb-10" style="background: linear-gradient(180deg, #fdfbf7 0%, #f7f2e7 400px, #f4eee2 100%);">


    <main class="w-full flex flex-col items-center relative">
        <SiteNav active="home" />
        {/* Banner Section */}
        <section class="w-full banner-luxury-bg border-b border-amber-200/40 relative overflow-hidden flex flex-col items-center">

            {/* Contenedor Banner: Mobile vs Desktop */}
            <div class="w-full max-w-[1440px] flex-1 px-4 md:px-8 pt-[84px] md:pt-[95px] pb-8 relative z-20 flex flex-col items-center">
                {/* Texto centrado en móvil y desktop */}
                <div class="home-hero-copy relative z-20 w-full max-w-[540px] md:max-w-[640px] mx-auto px-4 py-4 md:px-6 md:py-5 text-center">
                    <h1 class="font-archivo font-black text-amber-800 text-3xl md:text-5xl leading-none tracking-tight m-0">CAÑITA</h1>
                    <p class="font-poppins font-extrabold text-slate-900 text-base md:text-2xl leading-tight mt-2">Consulta por Placa o DNI</p>
                    <p class="font-poppins text-slate-700 text-xs md:text-sm leading-snug mt-2">Elige cómo consultar y revisa los resultados en una sola vista.</p>
                </div>

                {/* Vehículo decorativo móvil: Encima del botón, centrado */}
                <div class="md:hidden w-full max-w-[240px] mx-auto my-3 pointer-events-none flex justify-center">
                    <img src="/assets/autofondomovil.png" alt="Vehículo Cañita" class="w-full h-auto object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.28)]" />
                </div>

                {/* Autos laterales (pantallas grandes) */}
                <div class="hidden lg:block absolute left-[1%] xl:left-[3%] top-[315px] -translate-y-1/2 w-[270px] xl:w-[330px] z-10 pointer-events-none">
                    <img
                        src="/assets/autofondomovil.png"
                        alt="Vehículo Blanco"
                        class="w-full h-auto object-contain drop-shadow-[0_14px_28px_rgba(0,0,0,0.35)]"
                    />
                </div>
                <div class="hidden lg:block absolute right-[1%] xl:right-[3%] top-[315px] -translate-y-1/2 w-[285px] xl:w-[345px] z-10 pointer-events-none">
                    <img
                        src="/assets/autofondoweb.png"
                        alt="Vehículo Oscuro"
                        class="w-full h-auto object-contain drop-shadow-[0_14px_28px_rgba(0,0,0,0.35)]"
                    />
                </div>

                {/* Botón Ir a Consulta: colocado abajo, más apegado abajo */}
                <div class="relative z-20 w-full max-w-[340px] mx-auto mt-2 md:mt-7 mb-4 flex items-center justify-center px-3">
                    <a
                        href="/consulta"
                        class="btn-gold-action w-full py-3.5 sm:py-4 px-6 rounded-2xl font-extrabold text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-xl hover:scale-[1.02] active:scale-95 transition-all text-center tracking-wide"
                    >
                        <i class="fas fa-search text-base sm:text-lg"></i>
                        <span>Ir a Consulta</span>
                        <i class="fas fa-arrow-right text-xs opacity-80"></i>
                    </a>
                </div>
            </div>
        </section>

        {/* Botón para Mostrar/Ocultar Panel de Controles */}
        <div class="w-full max-w-[1100px] px-5 md:px-[15px] mt-8 flex justify-center z-10">
            <button
                id="toggle-controls-btn"
                class="flex items-center gap-2.5 px-6 py-2.5 rounded-full bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white transition-all duration-300 shadow-md text-xs font-semibold select-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-yellow/50 active:scale-95"
                aria-expanded="false"
                aria-controls="controls-panel"
            >
                <div class="relative flex items-center justify-center">
                    <i class="fas fa-filter text-slate-400 dark:text-brand-yellow"></i>
                    {/* Indicador de filtro activo */}
                    <span id="filter-active-dot" class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-brand-red dark:bg-brand-yellow hidden animate-pulse"></span>
                </div>
                <span>Buscar y Filtrar Consultas</span>
                <i id="toggle-icon" class="fas fa-chevron-down text-slate-400 dark:text-slate-500 transition-transform duration-300"></i>
            </button>
        </div>

        {/* Panel de Controles (Buscador + Pestañas de Filtro) - Colapsable */}
        <div id="controls-panel" class="hidden w-full max-w-[1100px] px-5 md:px-[15px] mt-4 z-10">
            <div class="bg-white/80 dark:bg-white/5 border border-black/5 dark:border-white/10 rounded-2xl p-4 backdrop-blur-md shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] flex flex-col gap-4">
                
                {/* Caja de Búsqueda */}
                <div class="relative max-w-lg w-full mx-auto">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-sm"></i>
                    <input
                        type="text"
                        id="search-input"
                        placeholder="Buscar consulta... (ej: SAT, SOAT, Arequipa)"
                        class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-slate-900/40 text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-red dark:focus:ring-brand-yellow focus:border-transparent transition-all duration-300 text-sm"
                        aria-label="Buscar consultas vehiculares"
                    />
                </div>

                {/* Tabs de Filtro */}
                <div id="categories-tabs" class="flex flex-wrap justify-center gap-1.5 md:gap-2 overflow-x-auto pb-1 max-w-full">
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-medium text-xs transition-all duration-300 bg-white text-slate-900 border border-transparent shadow-sm"
                        data-category="all"
                    >
                        Todos
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="registrales"
                    >
                        Registrales
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="infracciones"
                    >
                        Infracciones
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="tramites"
                    >
                        Trámites
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="provincias"
                    >
                        Provincias
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="tecnicas"
                    >
                        Técnicas
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10 flex items-center gap-1.5"
                        data-category="favoritos"
                    >
                        Favoritos <span id="favorites-badge" class="px-1.5 py-0.5 text-[9px] font-bold rounded-full bg-brand-red text-white hidden">0</span>
                    </button>
                </div>
            </div>
        </div>

        {/* Sección de Favoritos (Inicialmente oculta) */}
        <div id="favorites-section" class="category-section w-full max-w-[1100px] mt-8 px-5 md:px-[15px] hidden" data-category="favoritos">
            <div class="flex items-center gap-3 text-slate-800 dark:text-white border-b border-slate-200 dark:border-white/10 pb-2 mb-4">
                <i class="fas fa-star text-brand-yellow text-xl"></i>
                <h2 class="text-xl font-bold tracking-wide font-inter">Mis Consultas Favoritas</h2>
            </div>
            <div id="favorites-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-3.5 md:gap-2"></div>
        </div>

        {/* Secciones del Catálogo Dinámico */}
        {SERVICES_DATA.map((section) => (
            <div class="category-section w-full max-w-[1100px] mt-8 px-5 md:px-[15px]" data-category={section.id}>
                <div class="flex items-center gap-3 text-slate-800 dark:text-white border-b border-slate-200 dark:border-white/10 pb-2 mb-4">
                    <i class={`${section.icon} text-brand-red dark:text-brand-yellow text-xl`}></i>
                    <h2 class="text-xl font-bold tracking-wide font-inter">{section.title}</h2>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-3.5 md:gap-2">
                    {section.services.map((service) => (
                        <ServiceCard service={service} />
                    ))}
                </div>
            </div>
        ))}

        {/* Preguntas frecuentes (SEO: rich snippets) */}
        <div class="w-full max-w-[1100px] mt-10 px-5 md:px-[15px]">
            <div class="flex items-center gap-3 text-slate-800 dark:text-white border-b border-slate-200 dark:border-white/10 pb-2 mb-4">
                <i class="fas fa-circle-question text-brand-red dark:text-brand-yellow text-xl"></i>
                <h2 class="text-xl font-bold tracking-wide font-inter">Preguntas frecuentes sobre Cañita</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-3">
                <details class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 p-4">
                    <summary class="font-bold text-sm cursor-pointer">¿Qué es Cañita?</summary>
                    <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">Cañita es una plataforma peruana de consultas vehiculares por placa y consultas por DNI que unifica fuentes públicas oficiales en tiempo real.</p>
                </details>
                <details class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 p-4">
                    <summary class="font-bold text-sm cursor-pointer">¿Cómo consultar una placa vehicular en Perú?</summary>
                    <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">Ingresa la placa (ej. ABC-123) en el buscador y obtendrás SOAT, CITV, SUNARP, papeletas SUTRAN, SAT, Callao y más.</p>
                </details>
                <details class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 p-4">
                    <summary class="font-bold text-sm cursor-pointer">¿Cómo consultar por DNI?</summary>
                    <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">Ingresa los 8 dígitos del DNI para ver identidad, RUC SUNAT, multas JNE, licencias MTC, títulos MINEDU y presencia digital.</p>
                </details>
                <details class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 p-4">
                    <summary class="font-bold text-sm cursor-pointer">¿Consultar en Cañita es gratis?</summary>
                    <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">Sí, la consulta básica por placa o DNI en Cañita es gratuita.</p>
                </details>
            </div>
        </div>
    </main>

    {/* Footer */}
    <footer class="mt-16 py-10 px-5 bg-slate-100 dark:bg-[#0b1c36]/90 backdrop-blur-md border-t border-slate-200 dark:border-brand-red/20 text-center w-full">
        <div class="max-w-[1100px] mx-auto">
            {/* Tarjeta de Desarrollador y Contacto */}
            <div class="mb-8 p-6 md:p-8 sm:px-12 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm w-full max-w-3xl md:max-w-4xl mx-auto text-center font-sans">
                <p class="text-slate-400 dark:text-slate-400 font-archivo text-[10px] md:text-xs italic tracking-widest uppercase">Realizado por:</p>
                <p class="text-brand-navy-dark dark:text-brand-yellow font-dancing text-[28px] md:text-[34px] font-bold -mt-0.5 mb-0 text-[#0b1c36]">Huamani Gonzales Luis Antony</p>
                <p class="text-slate-600 dark:text-slate-300 font-archivo text-[10px] md:text-xs tracking-wider uppercase mb-3 opacity-90">Egresado de la carrera de Ingeniería de Sistemas</p>
                <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
                    <p class="text-slate-700 dark:text-slate-300 text-xs md:text-sm leading-relaxed font-medium">
                        Si tienes una <strong>idea de negocio</strong> o un <strong>proyecto tecnológico</strong> en mente, ¡puedes contactarme!
                    </p>
                    <div class="mt-3.5 flex flex-wrap items-center justify-center gap-2.5">
                        <a
                            href="https://www.instagram.com/luisantonyhg/"
                            target="_blank"
                            rel="noopener noreferrer"

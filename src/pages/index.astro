---
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES_DATA } from '../data/services';
---

<!DOCTYPE html>
<html lang="es" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard de Análisis Vehicular - Luis Antony</title>
    <meta name="description" content="Herramienta centralizada para análisis de vehículos. Consulta vehicular SUNARP, SOAT, papeletas, infracciones y más con solo la placa.">
    
    {/* Fuentes Google y FontAwesome */}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Dancing+Script:wght@700&family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-slate-50 dark:bg-brand-navy-dark text-slate-800 dark:text-white transition-colors duration-300 min-h-screen font-inter flex flex-col pb-10">

    {/* Header / Selector de Temas */}
    <header class="w-full max-w-[1100px] flex justify-end px-5 py-4 mx-auto md:px-[15px] z-20">
        <button
            id="theme-toggle"
            class="p-2.5 rounded-full bg-slate-200 dark:bg-white/10 text-slate-700 dark:text-white hover:bg-slate-300 dark:hover:bg-white/20 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-yellow/50"
            aria-label="Cambiar tema"
        >
            <i id="theme-toggle-icon" class="fas fa-moon text-lg transition-transform duration-300 hover:rotate-12"></i>
        </button>
    </header>

    <main class="w-full flex flex-col items-center">
        {/* Banner Section */}
        <section class="w-full bg-[radial-gradient(circle,_#1a3a6b_0%,_#0b1c36_100%)] border-y border-white/5 px-5 py-8 md:py-4 md:px-2 flex justify-center items-center overflow-hidden relative">
            <div class="max-w-[1100px] w-full flex flex-row flex-wrap md:flex-nowrap justify-between items-center gap-3 md:gap-5 px-0 md:px-2.5">
                
                {/* Toyota Fortuner (Izquierda en desktop, arriba izquierda en móvil) */}
                <img
                    src="/assets/fortuner.png"
                    alt="Toyota Fortuner"
                    class="car-img order-1 md:order-1 max-w-[100px] md:max-w-[280px] h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] z-10 -translate-x-3 md:translate-x-0 md:-ml-5 transition-transform duration-500 hover:scale-105"
                />

                {/* Contenido Central */}
                <div class="banner-content order-3 md:order-2 text-center flex-1 z-10 w-full md:w-auto -mt-2 md:mt-0 px-2">
                    <h1 class="text-brand-yellow font-archivo text-[36px] md:text-[55px] italic leading-[0.9] m-0 tracking-[-1.5px] md:tracking-[-2px] drop-shadow-[2px_2px_0px_rgba(0,0,0,0.5)] uppercase">
                        HERRAMIENTA
                    </h1>
                    <div class="text-brand-yellow font-dancing text-[26px] md:text-[38px] -my-[3px] flex justify-center items-center gap-2">
                        <span>para</span>
                        <span class="text-white">análisis</span>
                        <span class="text-white/80 font-normal font-sans text-lg md:text-2xl">de</span>
                        <span>Vehículos</span>
                    </div>
                    
                    <p class="text-white/95 text-xs md:text-sm mt-3.5 font-medium tracking-wide">
                        Conoce <strong class="font-extrabold text-brand-yellow">TODO</strong> sobre tu vehículo solo con su <strong class="font-extrabold text-brand-yellow">PLACA</strong>
                    </p>



                    {/* Botón para derivar a la nueva vista de consulta */}
                    <div class="mt-2 mb-4 flex justify-center">
                        <a
                            href="/consulta"
                            class="bg-brand-yellow hover:bg-[#ffd000]/95 text-brand-navy-dark px-5 py-2.5 rounded-xl transition-all duration-300 font-extrabold flex items-center gap-2 text-xs md:text-sm shadow-md active:scale-95 z-20"
                        >
                            <i class="fas fa-magnifying-glass-location"></i>
                            Ir a Consulta por Placa
                        </a>
                    </div>

                    <p class="text-white/60 text-[10px] md:text-xs mt-3 font-semibold tracking-widest uppercase">Realizado por:</p>
                    <p class="text-white text-base md:text-lg mt-0.5 font-light tracking-wide">Luis Antony Huamani Gonzales</p>
                </div>

                {/* Toyota Hilux (Derecha en desktop, arriba derecha en móvil) */}
                <img
                    src="/assets/hilux.png"
                    alt="Toyota Hilux"
                    class="car-img order-2 md:order-3 max-w-[100px] md:max-w-[280px] h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] z-10 translate-x-3 md:translate-x-0 md:-mr-5 transition-transform duration-500 hover:scale-105"
                />

            </div>
        </section>

        {/* Panel de Controles (Buscador + Pestañas de Filtro) */}
        <div class="w-full max-w-[1100px] px-5 md:px-[15px] mt-8 z-10">
            <div class="bg-white/80 dark:bg-white/5 border border-black/5 dark:border-white/10 rounded-2xl p-4 backdrop-blur-md shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] flex flex-col gap-4">
                
                {/* Caja de Búsqueda */}
                <div class="relative max-w-lg w-full mx-auto">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-sm"></i>
                    <input
                        type="text"
                        id="search-input"
                        placeholder="Buscar consulta... (ej: SAT, SOAT, Arequipa)"
                        class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-slate-900/40 text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-red dark:focus:ring-brand-yellow focus:border-transparent transition-all duration-300 text-sm"
                        aria-label="Buscar consultas vehiculares"
                    />
                </div>

                {/* Tabs de Filtro */}
                <div id="categories-tabs" class="flex flex-wrap justify-center gap-1.5 md:gap-2 overflow-x-auto pb-1 max-w-full">
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-medium text-xs transition-all duration-300 bg-white text-slate-900 border border-transparent shadow-sm"
                        data-category="all"
                    >
                        Todos
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="registrales"
                    >
                        Registrales
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="infracciones"
                    >
                        Infracciones
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="tramites"
                    >
                        Trámites
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="provincias"
                    >
                        Provincias
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
                        data-category="tecnicas"
                    >
                        Técnicas
                    </button>
                    <button
                        class="tab-btn px-4 py-2 rounded-lg font-normal text-xs transition-all duration-300 bg-slate-200/60 text-slate-700 hover:bg-slate-300/80 border border-transparent dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10 flex items-center gap-1.5"
                        data-category="favoritos"
                    >
                        Favoritos <span id="favorites-badge" class="px-1.5 py-0.5 text-[9px] font-bold rounded-full bg-brand-red text-white hidden">0</span>
                    </button>
                </div>
            </div>
        </div>

        {/* Sección de Favoritos (Inicialmente oculta) */}
        <div id="favorites-section" class="category-section w-full max-w-[1100px] mt-8 px-5 md:px-[15px] hidden" data-category="favoritos">
            <div class="flex items-center gap-3 text-slate-800 dark:text-white border-b border-slate-200 dark:border-white/10 pb-2 mb-4">
                <i class="fas fa-star text-brand-yellow text-xl"></i>
                <h2 class="text-xl font-bold tracking-wide font-inter">Mis Consultas Favoritas</h2>
            </div>
            <div id="favorites-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-3.5 md:gap-2"></div>
        </div>

        {/* Secciones del Catálogo Dinámico */}
        {SERVICES_DATA.map((section) => (
            <div class="category-section w-full max-w-[1100px] mt-8 px-5 md:px-[15px]" data-category={section.id}>
                <div class="flex items-center gap-3 text-slate-800 dark:text-white border-b border-slate-200 dark:border-white/10 pb-2 mb-4">
                    <i class={`${section.icon} text-brand-red dark:text-brand-yellow text-xl`}></i>
                    <h2 class="text-xl font-bold tracking-wide font-inter">{section.title}</h2>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-3.5 md:gap-2">
                    {section.services.map((service) => (
                        <ServiceCard service={service} />
                    ))}
                </div>
            </div>
        ))}
    </main>

    {/* Footer */}
    <footer class="mt-16 py-10 px-5 bg-slate-100 dark:bg-[#0b1c36]/90 backdrop-blur-md border-t border-slate-200 dark:border-brand-red/20 text-center w-full">
        <div class="max-w-[1100px] mx-auto">
            <p class="text-xs text-slate-400 dark:text-text-muted mb-1.5 uppercase tracking-widest">Realizado por:</p>
            <p class="text-lg md:text-xl font-extrabold text-slate-800 dark:text-white mb-5">Luis Antony Huamani Gonzales</p>
        </div>
    </footer>

    {/* Lógica Cliente */}
    <script>
        // --- 1. Lógica del Sistema de Favoritos (LocalStorage) ---
        function getFavorites() {
            try {
                return JSON.parse(localStorage.getItem('vehicle_favorites') || '[]');
            } catch (e) {
                return [];
            }
        }

        function saveFavorites(favs) {
            localStorage.setItem('vehicle_favorites', JSON.stringify(favs));
        }

        function isFavorite(id) {
            return getFavorites().includes(id);
        }

        function toggleFavorite(id) {
            let favs = getFavorites();
            if (favs.includes(id)) {
                favs = favs.filter(fId => fId !== id);
            } else {
                favs.push(id);
            }
            saveFavorites(favs);
            
            // Sincronizar las estrellas en todas las tarjetas de la página
            document.querySelectorAll(`[data-fav-id="${id}"] i`).forEach(star => {
                if (favs.includes(id)) {
                    star.className = 'fas fa-star text-brand-yellow text-sm md:text-[10px]';
                } else {
                    star.className = 'far fa-star text-sm md:text-[10px]';
                }
            });

            updateUI();
        }

        function updateFavoritesBadge() {
            const badge = document.getElementById('favorites-badge');
            if (badge) {
                const count = getFavorites().length;
                badge.textContent = count.toString();
                if (count > 0) {
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        }

        function renderFavorites() {
            const favGrid = document.getElementById('favorites-grid');
            const favSection = document.getElementById('favorites-section');
            if (!favGrid || !favSection) return;

            favGrid.innerHTML = '';
            const favs = getFavorites();
            const activeCat = (window as any).currentCategory || 'all';

            if (favs.length === 0) {
                favSection.classList.add('hidden');
                if (activeCat === 'favoritos') {
                    favGrid.innerHTML = `
                        <div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500">
                            <i class="far fa-star text-4xl mb-3 block text-brand-yellow/60"></i>
                            <p class="font-bold text-base">No tienes consultas favoritas aún</p>
                            <p class="text-xs mt-1">Haz clic en la estrella de cualquier tarjeta para fijarla aquí.</p>
                        </div>
                    `;
                    favSection.classList.remove('hidden');
                }
                return;
            }

            // Clonar tarjetas desde la vista original
            favs.forEach(id => {
                const originalCard = document.querySelector(`.category-section:not(#favorites-section) .service-card-wrapper[data-id="${id}"]`);
                if (originalCard) {
                    const cloned = originalCard.cloneNode(true) as HTMLElement;
                    
                    // Actualizar el estado de la estrella clonada
                    const star = cloned.querySelector('.favorite-btn i');
                    if (star) {
                        star.className = 'fas fa-star text-brand-yellow text-sm md:text-[10px]';
                    }

                    // Re-enganchar event listener en el botón clonado
                    const favBtn = cloned.querySelector('.favorite-btn');
                    if (favBtn) {
                        favBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            toggleFavorite(id);
                        });
                    }

                    favGrid.appendChild(cloned);
                }
            });

            if (activeCat === 'all' || activeCat === 'favoritos') {
                favSection.classList.remove('hidden');
            } else {
                favSection.classList.add('hidden');
            }
        }

        // --- 2. Lógica de Filtrado y Búsqueda ---
        (window as any).currentCategory = 'all';

        function updateUI() {
            const query = ((document.getElementById('search-input') as HTMLInputElement)?.value || '').toLowerCase().trim();
            const activeCat = (window as any).currentCategory;

            // Renderizar favoritos
            renderFavorites();

            // Filtrar grilla de favoritos
            const favGrid = document.getElementById('favorites-grid');
            if (favGrid) {
                const favCards = favGrid.querySelectorAll('.service-card-wrapper');
                favCards.forEach(card => {
                    const title = (card as HTMLElement).dataset.title || '';
                    if (title.includes(query)) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden');
                    }
                });
            }

            // Filtrar categorías y tarjetas regulares
            const sections = document.querySelectorAll('.category-section:not(#favorites-section)');
            sections.forEach(section => {
                const catId = (section as HTMLElement).dataset.category;
                const isCatActive = (activeCat === 'all' || activeCat === catId);

                if (!isCatActive) {
                    section.classList.add('hidden');
                    return;
                }

                const cards = section.querySelectorAll('.service-card-wrapper');
                let visibleCards = 0;
                cards.forEach(card => {
                    const title = (card as HTMLElement).dataset.title || '';
                    const matchesSearch = title.includes(query);
                    if (matchesSearch) {
                        card.classList.remove('hidden');
                        visibleCards++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                if (visibleCards > 0) {
                    section.classList.remove('hidden');
                } else {
                    section.classList.add('hidden');
                }
            });

            updateFavoritesBadge();
        }

        // Configurar Eventos para Tabs e Inputs
        document.addEventListener('DOMContentLoaded', () => {
            // Inicializar botones de favoritos
            document.querySelectorAll('.category-section:not(#favorites-section) .favorite-btn').forEach(btn => {
                const id = (btn as HTMLElement).dataset.favId;
                const star = btn.querySelector('i');
                if (id && star) {
                    if (isFavorite(id)) {
                        star.className = 'fas fa-star text-brand-yellow text-sm md:text-[10px]';
                    } else {
                        star.className = 'far fa-star text-sm md:text-[10px]';
                    }
                }
                
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (id) toggleFavorite(id);
                });
            });

            // Buscador
            const searchInput = document.getElementById('search-input');
            if (searchInput) {
                searchInput.addEventListener('input', updateUI);
            }

            // Tabs
            const tabButtons = document.querySelectorAll('.tab-btn');
            tabButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabButtons.forEach(b => {
                        b.classList.remove('bg-white', 'text-slate-900', 'font-medium', 'shadow-sm');
                        b.classList.add('bg-slate-200/60', 'text-slate-700', 'font-normal', 'dark:bg-white/5', 'dark:text-slate-300');
                    });

                    btn.classList.add('bg-white', 'text-slate-900', 'font-medium', 'shadow-sm');
                    btn.classList.remove('bg-slate-200/60', 'text-slate-700', 'font-normal', 'dark:bg-white/5', 'dark:text-slate-300');

                    (window as any).currentCategory = (btn as HTMLElement).dataset.category;
                    updateUI();
                });
            });

            // Cargar estado inicial
            updateUI();
        });

        // --- 3. Lógica del Selector de Temas ---
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-toggle-icon');

        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                if (themeIcon) {
                    themeIcon.className = 'fas fa-sun text-brand-yellow text-lg transition-transform duration-500 hover:rotate-45';
                }
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                if (themeIcon) {
                    themeIcon.className = 'fas fa-moon text-slate-700 dark:text-slate-400 text-lg transition-transform duration-500 hover:rotate-12';
                }
            }
        }

        // Tema inicial
        const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        applyTheme(savedTheme);

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                const isDark = document.documentElement.classList.contains('dark');
                applyTheme(isDark ? 'light' : 'dark');
            });
        }


    </script>
</body>

</html>

PUBLIC_BACKEND_URL=http://localhost:8000/api/v1
PUBLIC_CLIENT_SECRET=
# Clave pública del widget Managed de Cloudflare Turnstile. En localhost el
# código usa automáticamente la clave oficial de prueba interactiva.
PUBLIC_TURNSTILE_SITE_KEY=
# Número de atención para la tarjeta de Requisitorias (código país + número,
# solo dígitos). Ejemplo Perú: 519XXXXXXXX.
PUBLIC_WHATSAPP_NUMBER=
